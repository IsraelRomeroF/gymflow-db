// ============================================================================
// GymFlow — esquema OPERATIVO
// ============================================================================
// Este es el esquema que se MIGRA. Crece sprint a sprint hacia el modelo
// objetivo documentado en /prisma/schema.prisma (artefacto de diseño de la
// fase de Discovery, que NO se migra).
//
// Alcance actual: SPRINT 3 — + motor de membresías y paquetes de visitas.
//
// Constraints que Prisma no expresa de forma declarativa (índices parciales,
// CHECK, REVOKE) viven en migrations/*/constraints.sql y están marcados aquí
// con "-- SQL:". NO son opcionales: son garantías estructurales.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: las URLs ya NO viven aquí.
  //   · migraciones  -> prisma.config.ts  (rol gymflow_owner, propietario)
  //   · runtime      -> driver adapter    (rol gymflow_app, NO propietario)
  // Esa separación es lo que hace efectivos el REVOKE DELETE y el RLS de fase 2.
}

enum MemberStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Solo RECURRING genera ciclos de facturación (ADR-024).
enum BillingModel {
  RECURRING
  PREPAID_PERIOD
  VISIT_PACK
  DAY_PASS
}

enum DurationUnit {
  DAY
  WEEK
  MONTH
  VISIT
}

/// Resuelve el acceso multi-sucursal en el PLAN, sin inventar un motor de
/// reglas (§11.2).
enum BranchAccessScope {
  HOME_BRANCH
  LISTED_BRANCHES
  ALL_BRANCHES
}

enum MembershipStatus {
  PENDING
  TRIALING
  ACTIVE
  /// Dentro de la gracia: SÍ otorga acceso, intencionalmente (ADR-012).
  PAST_DUE
  /// Congelamiento acordado: EXTIENDE el periodo.
  FROZEN
  /// Por mora: NO extiende nada. El socio perdió esos días.
  SUSPENDED
  CANCELED
  EXPIRED
}

enum MembershipEventType {
  CREATED
  ACTIVATED
  TRIAL_STARTED
  FROZEN
  UNFROZEN
  PLAN_CHANGED
  RENEWED
  PAST_DUE
  SUSPENDED
  REACTIVATED
  DEBT_RESUMED
  DEBT_FORGIVEN
  CANCELED
  EXPIRED
}

enum VisitPackStatus {
  PENDING_PAYMENT
  ACTIVE
  EXHAUSTED
  EXPIRED
  FROZEN
}

enum VisitLedgerEntryType {
  PURCHASE
  CONSUME
  EXPIRE
  ADJUST
  REFUND
}

enum ProspectStatus {
  NEW
  CONTACTED
  VISITED
  TRIAL
  CONVERTED
  LOST
}

enum ConsentType {
  PRIVACY_NOTICE
  BIOMETRIC
  RECURRING_CHARGE
  MARKETING
  HOUSE_RULES
  HEALTH_DATA
}

enum AuditActorType {
  USER
  SYSTEM
  JOB
  GATEWAY
  MEMBER
}

/// EL TENANT (ADR-001). El socio pertenece a la Organization, nunca a una sucursal.
model Organization {
  consentSignatureRequests ConsentSignatureRequest[]
  planPriceChanges         PlanPriceChange[]
  privacyBatches           PrivacyBatch[]
  privacyConservationStart PrivacyConservationStart?
  privacyCalculatedBajaStart PrivacyCalculatedBajaStart?
  id                       String                    @id @db.Uuid
  legalName                String
  tradeName                String
  /// Branch.timezone la sobrescribe: México eliminó el horario de verano
  /// SALVO en la franja fronteriza norte (ADR-006).
  timezone                 String                    @default("America/Mexico_City")
  defaultCurrency          String                    @default("MXN") @db.Char(3)
  settings                 Json                      @default("{}")
  /// Estado del SERVICIO, lo decide la plataforma (ADR-037): PENDING (dada de
  /// alta, sin liberar), ACTIVE (en uso) o SUSPENDED. Fuera de ACTIVE nadie
  /// de la marca entra: ni su personal ni sus socios.
  serviceStatus            String                    @default("ACTIVE")
  activatedAt              DateTime?                 @db.Timestamptz(3)
  suspendedAt              DateTime?                 @db.Timestamptz(3)
  suspendedReason          String?
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?                 @db.Timestamptz(3)

  /// A quién le llega el estado de cuenta de la plataforma.
  billingEmail           String?
  /// Plan de la plataforma contratado (ADR-039): paquete de módulos con su
  /// precio mensual. NULL = contrato a la medida, módulo por módulo.
  platformPlanId         String?                   @db.Uuid
  platformPlan           PlatformPlan?             @relation(fields: [platformPlanId], references: [id])
  /// La VERSIÓN del plan que esta marca tiene (D-38, bloque 3.11):
  /// { planId, name, monthlyCents, modules, since }. El cobro lee esta, no el
  /// catálogo vivo: un cambio de plan le llega en la fecha avisada.
  platformPlanSnapshot   Json?
  /// Prórroga (D-37): la suspensión automática por adeudo no la toca hasta ese día, incluido.
  autoSuspendHoldUntil   DateTime?                 @db.Date
  /// La suspensión vigente la hizo el sistema por falta de pago, no una persona.
  suspendedAutomatically Boolean                   @default(false)
  // Bloque 4.6 (D-27): datos y marca que administra la plataforma; el panel solo los muestra.
  rfc                    String?
  /// Teléfono y WhatsApp del gimnasio (E.164).
  phone                  String?
  whatsapp               String?
  /// Lo que se imprime al pie del recibo.
  receiptLegend          String?
  /// El logo, como `data:` URL de una imagen pequeña (PNG, JPEG o WebP).
  logo                   String?
  changeRequests         GymChangeRequest[]
  platformNotices        PlatformNotice[]
  branches               Branch[]
  modules                OrganizationModule[]
  entitlements           OrganizationEntitlement[]
  platformInvoices       PlatformInvoice[]
  /// Descuentos o precio especial de su factura de GymFlow (D-39, bloque 4.9).
  billingAdjustments     OrganizationBillingAdjustment[]
  memberImports          MemberImport[]
  users                  User[]
  roles                  Role[]
  auditLogs              AuditLog[]
  roleLimits             RoleLimitSet[]
  members                Member[]
  plans                  Plan[]
  charges                Charge[]
  payments               Payment[]
  billingCycles          BillingCycle[]
  cashRegisters          CashRegister[]
  products               Product[]
  posSales               PosSale[]
  gateways               AccessGateway[]
  accessDecisions        AccessDecision[]
  attendance             AttendanceEvent[]
  credentials            MemberCredential[]
  portalInvites          PortalInvite[]
  portalSessions         MemberSession[]
  consentDocs            ConsentDocument[]
  intakes                MemberIntake[]
  enrollments            BiometricEnrollment[]
  classTypes             ClassType[]
  classSettings          ClassSettings?
  // Bloque 3.5 (D-13, D-15): marcas y devoluciones de tienda, y los topes del cajón.
  posSaleFlags           PosSaleFlag[]
  posSaleReturns         PosSaleReturn[]
  cashSettings           CashSettings?
  memberTermSettings     MemberTermSettings?
  classPauses            ClassPause[]
  paymentMethods         PaymentMethod[]
  webhookEvents          WebhookEvent[]
  exercises              Exercise[]
  workoutTemplates       WorkoutTemplate[]
  workoutAssignments     WorkoutAssignment[]
  memberNotices          MemberNotice[]
  privacyRequests        PrivacyRequest[]
  pushSubscriptions      PushSubscription[]
  approvalProxies        ApprovalProxy[]
  monthlyCloses          MonthlyClose[]
  followUps              FollowUp[]
  outboundMessages       OutboundMessage[]
  memberPushSubscriptions       MemberPushSubscription[]
  memberNotificationPreferences MemberNotificationPreference[]
  memberContactChanges          MemberContactChange[]
  prospectSources        ProspectSource[]
  prospectAutoCloseStart ProspectAutoCloseStart?
  // Bloque 4.2 (D-05): avisos a la dueña, su arranque y qué apagó cada quien.
  ownerAlerts            OwnerAlert[]
  ownerAlertStart        OwnerAlertStart?
  pushPreferences        PushPreference[]
  faceTemplates          FaceTemplate[]
  faceMeasurements       FaceMeasurement[]
  trialPasses            TrialPass[]

  @@map("organizations")
}

model Branch {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  code           String
  name           String
  addressLine    String?
  /// Nombre corto y ÚNICO entre todos los gimnasios para el enlace público del
  /// alta (`/alta/demo-centro`). El código de sede se repite entre clientes,
  /// así que no sirve para eso (UXB-14).
  publicSlug     String?   @unique
  /// Nullable = hereda la zona de la organización.
  timezone       String?
  /// Versión del padrón firmado. MONÓTONA: es lo que impide que un gateway
  /// acepte un padrón anterior en el que un socio expulsado aún figuraba.
  rosterVersion  BigInt    @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization     Organization             @relation(fields: [organizationId], references: [id])
  roleAssignments  RoleAssignment[]
  homeMembers      Member[]                 @relation("MemberHomeBranch")
  planAvailability PlanBranchAvailability[]
  soldMemberships  Membership[]             @relation("MembershipSoldAt")
  membershipAccess MembershipBranchAccess[]
  charges          Charge[]                 @relation("ChargeBranch")
  payments         Payment[]                @relation("PaymentBranch")
  cashRegisters    CashRegister[]
  cashSessions     CashSession[]            @relation("CashSessionBranch")
  posSales         PosSale[]                @relation("PosSaleBranch")
  inventoryStock   InventoryStock[]
  inventoryMoves   InventoryMovement[]
  gateways         AccessGateway[]
  accessDecisions  AccessDecision[]         @relation("AccessDecisionBranch")
  attendance       AttendanceEvent[]        @relation("AttendanceBranch")
  trialPasses      TrialPass[]              @relation("TrialPassBranch")
  intakes          MemberIntake[]           @relation("IntakeBranch")
  enrollments      BiometricEnrollment[]    @relation("EnrollmentBranch")
  classTemplates   ClassTemplate[]          @relation("ClassTemplateBranch")
  classSchedules   ClassSchedule[]          @relation("ClassScheduleBranch")
  classPauses      ClassPause[]             @relation("ClassPauseBranch")
  // Bloque 4.6 (D-27): teléfono y horario de la sucursal; los administra la plataforma.
  phone            String?
  /// En texto: «Lunes a viernes de 6:00 a 22:00».
  openingHours     String?
  changeRequests   GymChangeRequest[]

  /// Soporte de las FKs compuestas que impiden cruzar tenants (ADR-001).
  moduleOverrides BranchModuleOverride[]

  @@unique([id, organizationId], map: "branches_id_org_key")
  // -- SQL: UNIQUE (organization_id, code) WHERE deleted_at IS NULL
  @@index([organizationId, isActive])
  @@map("branches")
}

/// Cuenta de acceso del PERSONAL. Un socio NO es un User (ADR-023).
model User {
  privacyBatchesSigned  PrivacyBatch[] @relation("PrivacyBatchSigner")
  id                    String         @id @db.Uuid
  /// Nullable SOLO para el superadmin de plataforma (cross-tenant).
  organizationId        String?        @db.Uuid
  email                 String
  passwordHash          String
  fullName              String
  phoneE164             String?
  mfaEnabled            Boolean        @default(false)
  isActive              Boolean        @default(true)
  lastLoginAt           DateTime?      @db.Timestamptz(3)
  failedLogins          Int            @default(0)
  /// Bloqueo temporal progresivo tras N fallos (§27).
  lockedUntil           DateTime?      @db.Timestamptz(3)
  /// La contraseña la puso otra persona (alta o restablecimiento): se cambia
  /// al entrar y, mientras tanto, no sirve para autorizar (SEC2-08).
  mustChangePassword    Boolean        @default(false)
  /// Secciones de Dirección y Cumplimiento que el dueño le liberó (claves de
  /// `LOCKABLE_SECTIONS`). Vacío = ninguna. El dueño no la necesita.
  unlockedSections      Json           @default("[]")
  /// Lo que la PLATAFORMA deja ver al dueño; null = todo. Mismas claves que la llave.
  platformSections      Json?
  /// Ajustes de permisos de esta persona sobre su puesto: { add, remove }, de
  /// la lista cerrada `ADJUSTABLE_PERMISSIONS`. null = exactamente su puesto.
  permissionOverrides   Json?
  passwordResetAt       DateTime?      @db.Timestamptz(3)
  passwordResetByUserId String?        @db.Uuid
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?      @db.Timestamptz(3)

  organization      Organization?      @relation(fields: [organizationId], references: [id])
  roleAssignments   RoleAssignment[]   @relation("AssignmentUser")
  grantedRoles      RoleAssignment[]   @relation("AssignmentGrantedBy")
  sociosComoCoach   Member[]           @relation("MemberCoach")
  sessions          Session[]
  mfaFactors        MfaFactor[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  pushSubscriptions PushSubscription[]
  pushPreferences   PushPreference[]
  /// Bloque 3.1: nombramientos de apoderado que dio (dueño) y que recibió, y sus equipos conocidos.
  approvalProxiesGranted ApprovalProxy[] @relation("ApprovalProxyGrantor")
  approvalProxiesHeld    ApprovalProxy[] @relation("ApprovalProxyHolder")
  knownDevices           KnownDevice[]
  gymChangeRequests      GymChangeRequest[]

  @@unique([id, organizationId], map: "users_id_org_key")
  // -- SQL: UNIQUE (organization_id, lower(email)) WHERE deleted_at IS NULL
  @@index([organizationId, isActive])
  @@map("users")
}

model Role {
  id             String  @id @db.Uuid
  /// NULL = rol de sistema, compartido por todas las organizaciones.
  organizationId String? @db.Uuid
  key            String
  name           String
  isSystem       Boolean @default(false)

  organization Organization?    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  assignments  RoleAssignment[]
  limits       RoleLimitSet[]

  @@unique([organizationId, key])
  @@map("roles")
}

/// Catálogo GLOBAL de la plataforma: deliberadamente SIN organizationId.
model Permission {
  key              String  @id
  domain           String
  description      String
  requiresReason   Boolean @default(false)
  requiresApproval Boolean @default(false)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// EL MECANISMO DE SCOPING (ADR-009).
/// branchId NULL = alcance organizacional. Un gerente que cubre dos sedes
/// tiene dos filas.
model RoleAssignment {
  id              String    @id @db.Uuid
  organizationId  String    @db.Uuid
  userId          String    @db.Uuid
  roleId          String    @db.Uuid
  branchId        String?   @db.Uuid
  grantedAt       DateTime  @default(now()) @db.Timestamptz(3)
  grantedByUserId String?   @db.Uuid
  revokedAt       DateTime? @db.Timestamptz(3)

  /// Relaciones COMPUESTAS: la base rechaza ligar un usuario o una sucursal
  /// de otra organización. Es el control nº3 de ADR-001, y se declara aquí
  /// —no en SQL crudo— para que Prisma no lo trate como deriva.
  user      User    @relation("AssignmentUser", fields: [userId, organizationId], references: [id, organizationId], map: "role_assignments_user_same_org_fk")
  grantedBy User?   @relation("AssignmentGrantedBy", fields: [grantedByUserId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])
  branch    Branch? @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "role_assignments_branch_same_org_fk")

  // -- SQL: UNIQUE (user_id, role_id, COALESCE(branch_id, '00000000-...'))
  //         WHERE revoked_at IS NULL
  @@index([organizationId, userId, revokedAt])
  @@map("role_assignments")
}

/// Límites cuantitativos por rol y organización (ADR-009).
/// NULL = sin límite. Viven en configuración, NUNCA en el código.
model RoleLimitSet {
  id             String @id @db.Uuid
  organizationId String @db.Uuid
  roleId         String @db.Uuid

  maxDiscountPercent            Int?
  maxWaiverAmountCents          BigInt?
  maxManualBalanceAdjustCents   BigInt?
  maxCashWithdrawalCents        BigInt?
  maxRefundAmountCents          BigInt?
  /// Se ALERTA al excederlo, jamás se bloquea: si el sistema impidiera dejar
  /// entrar a alguien, recepción se lo saltaría y el dato se perdería.
  maxManualAccessGrantsPerShift Int?
  maxPosVoidsPerShift           Int?

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, roleId])
  @@map("role_limit_sets")
}

/// Sesión OPACA del lado del servidor (ADR-008). No JWT: revocar es borrar
/// una fila y surte efecto en la siguiente petición.
/// Autorización de un SEGUNDO usuario (maker-checker), de un solo uso.
///
/// Antes bastaba con mandar el id del aprobador: nadie comprobaba que esa
/// persona estuviera ahí. Ahora el aprobador teclea su contraseña (y su
/// código 2FA si lo tiene) y recibe un token atado al permiso, a quien lo
/// pidió y a cinco minutos. Solo se guarda su sha256.
model ApprovalGrant {
  id                String    @id @db.Uuid
  organizationId    String    @db.Uuid
  approverUserId    String    @db.Uuid
  requestedByUserId String    @db.Uuid
  permission        String
  tokenHash         String    @unique
  /// A QUÉ se autorizó (SEC2-05): la sede, el recurso y el importe. Una firma
  /// para "reembolsar $300 de este pago" no sirve para $30,000 de otro.
  branchId          String?   @db.Uuid
  resourceType      String?
  resourceId        String?   @db.Uuid
  amountCents       BigInt?
  expiresAt         DateTime  @db.Timestamptz(3)
  usedAt            DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  /// D-02 (bloque 3.1): el nombramiento con el que se firmó «como apoderado»; null = firmó el dueño.
  proxyId           String?   @db.Uuid
  proxy             ApprovalProxy? @relation(fields: [proxyId], references: [id], onDelete: Restrict)

  @@index([organizationId, approverUserId, createdAt])
  @@map("approval_grants")
}

/// APODERADO TEMPORAL (D-02, bloque 3.1): el dueño nombra a UNA persona con
/// fecha de fin para dar la segunda firma a lo que piden los demás. Vigente =
/// `endedAt` null y `endsAt` en el futuro. Nunca se borra (constancia). Un
/// solo nombramiento abierto por gimnasio: índice único parcial en la migración.
model ApprovalProxy {
  id              String    @id @db.Uuid
  organizationId  String    @db.Uuid
  grantedByUserId String    @db.Uuid
  proxyUserId     String    @db.Uuid
  note            String?
  endsAt          DateTime  @db.Timestamptz(3)
  endedAt         DateTime? @db.Timestamptz(3)
  /// REVOKED (lo revocó el dueño), EXPIRED (llegó su fecha) o REPLACED (se nombró a otra persona).
  endReason       String?
  endedByUserId   String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grantedBy    User         @relation("ApprovalProxyGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  proxyUser    User         @relation("ApprovalProxyHolder", fields: [proxyUserId], references: [id], onDelete: Restrict)
  grants       ApprovalGrant[]
  requests     ApprovalRequest[]

  @@index([organizationId, createdAt])
  @@index([proxyUserId])
  @@map("approval_proxies")
}

/// EQUIPO CONOCIDO (D-01, bloque 3.1): el navegador en el que una persona ya
/// entró con su cuenta. Guarda solo el sha256 de una llave al azar que vive en
/// una cookie; con él y la contraseña correcta el titular pasa el bloqueo por
/// intentos fallidos aunque su IP haya cambiado.
model KnownDevice {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  keyHash    String
  label      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyHash])
  @@map("known_devices")
}

/// AUTORIZACIÓN A DISTANCIA: quien opera pide la firma y quien puede darla
/// la aprueba desde su propio teléfono, con su contraseña.
/// Aprobada, se emite una `ApprovalGrant` atada a la misma operación e
/// importe; su token viaja cifrado aquí y se le entrega a quien la pidió
/// mientras la firma no se use ni venza; después se borra (29-03).
model ApprovalRequest {
  id                String            @id @db.Uuid
  organizationId    String            @db.Uuid
  requestedByUserId String            @db.Uuid
  permission        String
  branchId          String?           @db.Uuid
  resourceType      String?
  resourceId        String?           @db.Uuid
  amountCents       BigInt?
  /// Lo que verá quien autoriza: "Reembolso de $300 a Ana López".
  summary           String
  /// El motivo que escribió quien pide: quien firma lo lee antes de decidir (UXG-05).
  reason            String?
  status            String            @default("PENDING")
  approverUserId    String?           @db.Uuid
  decidedAt         DateTime?         @db.Timestamptz(3)
  rejectReason      String?
  /// Token de la firma, CIFRADO, mientras la firma no se use ni venza: si se
  /// pierde la respuesta que lo trae, se vuelve a entregar (29-03).
  deliveryToken     String?
  /// La firma que emitió al aprobarse: dice si ya se usó o venció (29-03).
  grantId           String?           @db.Uuid
  /// A cuántos teléfonos salió el aviso al pedirla (29-05, bloque 2.10).
  notifiedCount     Int               @default(0)
  /// Cuándo salió ese aviso; null si no salió ninguno.
  deliveredAt       DateTime?         @db.Timestamptz(3)
  /// La primera vez que la bandeja de alguien que puede firmarla la mostró (29-05).
  seenAt            DateTime?         @db.Timestamptz(3)
  /// D-03 (bloque 3.2): la solicitud RECHAZADA de la misma operación a la que esta responde.
  previousRequestId String?           @db.Uuid
  previousRequest   ApprovalRequest?  @relation("ApprovalRequestReask", fields: [previousRequestId], references: [id], onDelete: SetNull)
  nextRequests      ApprovalRequest[] @relation("ApprovalRequestReask")
  /// Lo que quien pide le contesta a ese «no»: obligatorio para volver a pedir.
  reply             String?
  /// «Preguntar» en vez de rechazar: la solicitud sigue PENDING con la pregunta puesta.
  question          String?
  questionAt        DateTime?         @db.Timestamptz(3)
  questionByUserId  String?           @db.Uuid
  /// Lo que contestó quien pidió.
  answer            String?
  answeredAt        DateTime?         @db.Timestamptz(3)
  /// D-02 (bloque 3.1): el nombramiento con el que se contestó «como apoderado»; null = contestó el dueño.
  proxyId           String?           @db.Uuid
  proxy             ApprovalProxy?    @relation(fields: [proxyId], references: [id], onDelete: Restrict)
  expiresAt         DateTime          @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, permission, resourceId, createdAt], map: "approval_requests_operacion_idx")
  @@map("approval_requests")
}

/// ESCALERA DE FALLOS DE LA SEGUNDA FIRMA (24-11, D24-04), aparte del bloqueo
/// del inicio de sesión. Una fila por persona que alguna vez falló una firma:
/// al 3.er fallo en 10 minutos se le avisa; al 5.º sus firmas quedan en pausa
/// 10 minutos y se avisa a la dueña. Su entrada al panel no se toca.
model ApprovalSignerLock {
  userId          String    @id @db.Uuid
  organizationId  String    @db.Uuid
  failedCount     Int       @default(0)
  /// Primer fallo de la ventana de 10 minutos en curso.
  windowStartedAt DateTime? @db.Timestamptz(3)
  pausedUntil     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@map("approval_signer_locks")
}

/// MÓDULOS que el gimnasio encendió o apagó a mano (ADR-036).
///
/// Sin fila = el valor por omisión del catálogo de `@gymflow/core`: un
/// gimnasio que nunca tocó nada, y un módulo que nazca mañana, no necesitan
/// relleno. La clave se valida contra el catálogo en el backend, no con un
/// enum aquí, para no migrar cada vez que nazca un módulo.
/// Apagar no borra nada: la fila queda como rastro y se vuelve a encender.
model OrganizationModule {
  organizationId  String   @db.Uuid
  moduleKey       String
  enabled         Boolean
  /// Por qué se apagó: lo lee quien llega a la sección y la encuentra apagada.
  reason          String?
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid
  /// Apagar con borrado avisado (3.12, D-32: los rostros de Biometría): el día
  /// en que se borra y cuántos decía el aviso. NULL = nada avisado, nada se borra.
  erasureOn       DateTime? @db.Date
  erasureWarned   Int?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, moduleKey])
  @@map("organization_modules")
}

/// CORRIDAS DE LOS JOBS (auditoría 8, fase 1, bloque 1.16; 28-15). Una fila
/// por corrida del cierre diario (`runner` = DAILY) o del corredor de 15
/// minutos (FREQUENT). El candado es el índice único parcial sobre `runner`
/// con `status` RUNNING (en la migración, a mano): dos corridas del mismo
/// corredor no arrancan juntas. `heartbeatAt` lo refresca el proceso cada 30 s;
/// una corrida RUNNING sin señal de vida se da por ABANDONED en la siguiente,
/// con sus pasos a medias. No es append-only: el corredor de 15 minutos borra
/// los pasos que no encontraron nada que hacer, y el cierre diario purga las
/// corridas frecuentes vacías de más de una semana.
model JobRun {
  id          String    @id @db.Uuid
  /// DAILY (cierre diario) o FREQUENT (cada 15 minutos).
  runner      String
  /// RUNNING, OK, WITH_ERRORS (errores por entidad), FAILED (un job reventó) o ABANDONED.
  status      String
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  heartbeatAt DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  /// Quién corrió: `host#pid`, para distinguir un cron de una corrida a mano.
  host        String
  /// Perfil de arranque (`uso-real`, `pruebas`) o null.
  perfil      String?
  /// Cifras de la corrida al cerrar: gimnasios, jobs, fallidos, saltados por «ya corrió hoy».
  summary     Json?
  /// Por qué quedó ABANDONED, o lo que haya que decir de la corrida.
  note        String?

  steps JobRunStep[]

  @@index([runner, startedAt])
  @@map("job_runs")
}

/// Un job en un gimnasio (o de plataforma: `organizationId` null) dentro de
/// una corrida. `businessDate` es la fecha de negocio del gimnasio al correr
/// (o la de CDMX para los de plataforma): con ella el cierre diario sabe que
/// ese job ya corrió hoy y no lo repite. Segundo candado (migración
/// `20261120100000_job_runs_candado_por_job`, a mano): un índice único parcial
/// sobre (`job`, gimnasio) con `status` RUNNING impide que el mismo job corra
/// a la vez para el mismo gimnasio desde el cierre diario y desde el corredor.
model JobRunStep {
  id             String    @id @db.Uuid
  runId          String    @db.Uuid
  organizationId String?   @db.Uuid
  job            String
  businessDate   DateTime  @db.Date
  /// RUNNING, OK, WITH_ERRORS, FAILED o ABANDONED.
  status         String
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  processed      Int       @default(0)
  skipped        Int       @default(0)
  batches        Int       @default(0)
  truncated      Boolean   @default(false)
  /// `[{ entityId, error }]` del resultado del job.
  errors         Json      @default("[]")
  /// El mensaje si el job reventó (FAILED) o por qué se abandonó.
  error          String?

  run JobRun @relation(fields: [runId], references: [id])

  @@index([organizationId, job, businessDate])
  @@index([runId])
  @@map("job_run_steps")
}

/// PRECIOS DE LA PLATAFORMA (ADR-038): cuánto cobra GymFlow al mes por cada
/// módulo opcional y por lo básico (`core`). Los fija quien opera la
/// plataforma; sin precio no se puede facturar. Un cambio no toca las
/// facturas ya emitidas: cada una guarda sus líneas.
/// Paquetes de módulos que la plataforma vende (ADR-039). Los define quien
/// opera GymFlow: nombre, qué módulos incluye y cuánto cuesta al mes. Un
/// gimnasio contrata un plan y, encima, módulos sueltos como agregados.
model PlatformPlan {
  id           String   @id @db.Uuid
  name         String
  description  String?
  /// Claves de módulos OPCIONALES incluidos (`core` siempre va).
  modules      Json     @default("[]")
  /// NULL = sin precio fijado: se factura módulo por módulo.
  monthlyCents BigInt?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  organizations Organization[]
  priceChanges  PlatformPriceChange[]

  @@map("platform_plans")
}

/// CAMBIO ANUNCIADO de un precio o de un plan de GymFlow (D-38, bloque 3.11):
/// aplica a todas las marcas desde el día 1 de un mes, con un mes de aviso.
/// Hasta entonces cada marca conserva lo que tenía. No se borra: de aquí sale
/// lo que valía un mes pasado.
model PlatformPriceChange {
  id               String    @id @db.Uuid
  /// PRICE (un precio suelto, `moduleKey`) o PLAN (precio y módulos de `planId`).
  kind             String
  moduleKey        String?
  planId           String?   @db.Uuid
  /// PRICE: { monthlyCents }. PLAN: { monthlyCents, modules }.
  before           Json
  after            Json
  /// Día 1 del mes de la primera factura con lo nuevo.
  effectiveFrom    DateTime  @db.Date
  announcedOn      DateTime  @db.Date
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  createdByUserId  String?   @db.Uuid
  appliedAt        DateTime? @db.Timestamptz(3)
  canceledAt       DateTime? @db.Timestamptz(3)
  canceledByUserId String?   @db.Uuid
  cancelReason     String?

  plan PlatformPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)

  // -- SQL: CHECK día 1, effectiveFrom > announcedOn, un solo pendiente por precio y por plan (índices únicos parciales); REVOKE DELETE
  @@index([effectiveFrom], map: "platform_price_changes_effective_idx")
  @@map("platform_price_changes")
}

/// AVISO de GymFlow al dueño de una marca (D-37, bloque 3.11): factura
/// emitida, vencida, servicio suspendido, cambio de precio. `deliveredOn` es
/// el primer día con constancia de que le llegó (notificación a su teléfono,
/// visto en su panel o mandado por una persona de GymFlow): desde ahí cuenta
/// la suspensión automática. No se borra.
model PlatformNotice {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  /// INVOICE_ISSUED · INVOICE_OVERDUE · SERVICE_SUSPENDED · PRICE_CHANGE · PRICE_CHANGE_CANCELED
  kind           String
  dedupeKey      String    @unique(map: "platform_notices_dedupe_key")
  invoiceId      String?   @db.Uuid
  priceChangeId  String?   @db.Uuid
  title          String
  body           String
  /// El día (Ciudad de México) en que nació.
  noticeOn       DateTime  @db.Date
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  pushedAt       DateTime? @db.Timestamptz(3)
  pushDevices    Int       @default(0)
  seenAt         DateTime? @db.Timestamptz(3)
  seenByUserId   String?   @db.Uuid
  sentAt         DateTime? @db.Timestamptz(3)
  sentByUserId   String?   @db.Uuid
  deliveredOn    DateTime? @db.Date
  /// Ya no hace falta: PAID · VOIDED · RESUMED · CANCELED · APPLIED.
  closedAt       DateTime? @db.Timestamptz(3)
  closeReason    String?

  organization Organization     @relation(fields: [organizationId], references: [id])
  invoice      PlatformInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // -- SQL: CHECK deliveredOn ⇔ alguna vía; REVOKE DELETE
  @@index([organizationId, closedAt, createdAt], map: "platform_notices_org_idx")
  @@index([invoiceId], map: "platform_notices_invoice_idx")
  @@map("platform_notices")
}

/// «PEDIR UN CAMBIO A GYMFLOW» (D-27, bloque 4.6): la solicitud que la dueña o
/// la gerencia mandan desde «Mi gimnasio» para cambiar un dato o la marca. La
/// plataforma la aplica o la rechaza con respuesta. No se borra.
model GymChangeRequest {
  id                String    @id @db.Uuid
  organizationId    String    @db.Uuid
  /// Solo en los datos de sucursal (BRANCH_PHONE, BRANCH_HOURS).
  branchId          String?   @db.Uuid
  /// LEGAL_NAME · RFC · TRADE_NAME · LOGO · PHONE · WHATSAPP · RECEIPT_LEGEND · BRANCH_PHONE · BRANCH_HOURS · OTHER
  field             String
  proposedValue     String?
  /// Solo con LOGO: la imagen propuesta, como `data:` URL.
  proposedLogo      String?
  reason            String
  requestedByUserId String    @db.Uuid
  requestedAt       DateTime  @default(now()) @db.Timestamptz(3)
  /// PENDING · APPLIED · REJECTED
  status            String    @default("PENDING")
  /// Lo que GymFlow le contesta a quien la pidió (obligatorio al rechazar).
  response          String?
  /// El valor que quedó al aplicarla (GymFlow puede ajustar lo propuesto).
  appliedValue      String?
  /// La cuenta de plataforma que la resolvió.
  resolvedByUserId  String?   @db.Uuid
  resolvedAt        DateTime? @db.Timestamptz(3)
  /// Cuándo vio el resultado quien la pidió.
  seenAt            DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  // -- SQL: CHECK de campo, estado, resuelta ⇔ fecha, rechazo con respuesta, sede ⇔ dato de sucursal; REVOKE DELETE
  @@index([organizationId, requestedAt], map: "gym_change_requests_org_idx")
  @@index([status, requestedAt], map: "gym_change_requests_status_idx")
  @@map("gym_change_requests")
}

model PlatformPrice {
  moduleKey       String   @id
  monthlyCents    BigInt
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid

  @@map("platform_prices")
}

/// FACTURAS de la plataforma a cada marca (ADR-038): una por mes, con las
/// líneas de lo contratado al emitirla y su precio de ese momento. Se paga
/// o se anula; nunca se borra. Es un comprobante interno, no un CFDI.
model PlatformInvoice {
  id              String    @id @db.Uuid
  organizationId  String    @db.Uuid
  /// GF-2026-000012: correlativo por año, legible para el dueño.
  folio           String    @unique
  periodStart     DateTime  @db.Date
  /// Exclusivo: el primer día del mes siguiente.
  periodEnd       DateTime  @db.Date
  /// [{ key, name, monthlyCents }]
  lines           Json
  totalCents      BigInt
  status          String    @default("PENDING")
  issuedAt        DateTime  @default(now()) @db.Timestamptz(3)
  dueDate         DateTime  @db.Date
  paidAt          DateTime? @db.Timestamptz(3)
  paymentMethod   String?
  paymentRef      String?
  note            String?
  voidReason      String?
  createdByUserId String?   @db.Uuid
  /// Lo pagado hasta hoy: la suma de sus pagos vivos (bloque 1.13, 23-08).
  /// `paidAt`, `paymentMethod` y `paymentRef` son los del último pago vivo.
  paidCents       BigInt    @default(0)
  // Bloque 4.9 (D-39). `totalCents` sigue siendo LO QUE SE PAGA. Una factura
  // anterior a D-39 tiene `subtotalCents` NULL: total sin desglose de IVA.
  subtotalCents   BigInt?
  taxCents        BigInt    @default(0)
  /// Puntos base: 1600 = 16 %. 0 = sin IVA.
  taxRateBps      Int       @default(0)
  /// Los precios ya incluían el IVA (el total no subió; solo se desglosó).
  taxIncluded     Boolean   @default(false)
  /// El descuento que llevó; también va como renglón en `lines`, en negativo.
  discountCents   BigInt    @default(0)
  /// { legalName, rfc, tradeName } del gimnasio y { legalName, rfc, address, payment, contact } de GymFlow, como estaban al emitir.
  receiver        Json?
  issuer          Json?

  organization Organization      @relation(fields: [organizationId], references: [id])
  payments     PlatformPayment[]
  notices      PlatformNotice[]

  // -- SQL: UNIQUE (organizationId, periodStart) WHERE status <> 'VOID'
  //         ^^^ una factura VIVA por mes y marca: la anulada no estorba para emitir otra (DP-03).
  // -- SQL: CHECK (paidCents BETWEEN 0 AND totalCents); CHECK (status <> 'PAID' OR paidCents = totalCents)
  // -- SQL: CHECK (taxCents >= 0 AND discountCents >= 0 AND (subtotalCents IS NULL OR subtotalCents + taxCents = totalCents))
  @@index([organizationId, status])
  @@index([status, dueDate])
  @@map("platform_invoices")
}

/// PAGOS de una factura de la plataforma (auditoría 8, bloque 1.13; 23-07 y
/// 23-08): uno por abono, con su importe, su forma y su referencia. Un pago
/// registrado por error se DESHACE con motivo (`undoneAt`); nunca se borra.
/// Descuento o precio especial de una marca en su factura de GymFlow, por
/// meses y con motivo (D-39, bloque 4.9). Caduca solo; no se edita ni se
/// borra: se cancela y se da otro.
model OrganizationBillingAdjustment {
  id               String    @id @db.Uuid
  organizationId   String    @db.Uuid
  /// PERCENT (`percentBps`: 2000 = 20 %) · AMOUNT (importe fijo al mes) · SPECIAL_PRICE (la mensualidad completa, sin IVA, cuesta `amountCents`).
  kind             String
  percentBps       Int?
  amountCents      BigInt?
  /// Día 1 del mes de la primera factura con el ajuste.
  fromMonth        DateTime  @db.Date
  /// Cuántas facturas mensuales lo llevan.
  months           Int
  /// Sale en el renglón de la factura.
  reason           String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  createdByUserId  String?   @db.Uuid
  canceledAt       DateTime? @db.Timestamptz(3)
  canceledByUserId String?   @db.Uuid
  cancelReason     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // -- SQL: CHECK por clase, día 1, 1 a 24 meses, motivo; REVOKE DELETE
  @@index([organizationId, fromMonth], map: "organization_billing_adjustments_org_idx")
  @@map("organization_billing_adjustments")
}

/// El IVA de las facturas de GymFlow desde la de un mes (D-39, bloque 4.9).
/// Sin filas no hay IVA. Para un mes manda la fila viva más reciente que ya empezó.
model PlatformTaxChange {
  id               String    @id @db.Uuid
  /// Puntos base: 1600 = 16 %; 0 = sin IVA.
  rateBps          Int
  /// Falso: se suma a los precios (el total sube). Verdadero: los precios ya lo incluyen (solo se desglosa).
  included         Boolean   @default(false)
  effectiveFrom    DateTime  @db.Date
  announcedOn      DateTime  @db.Date
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  createdByUserId  String?   @db.Uuid
  canceledAt       DateTime? @db.Timestamptz(3)
  canceledByUserId String?   @db.Uuid
  cancelReason     String?

  // -- SQL: CHECK tasa 0 a 5000, día 1; UNIQUE (effectiveFrom) WHERE canceledAt IS NULL; REVOKE DELETE
  @@map("platform_tax_changes")
}

model PlatformPayment {
  id              String    @id @db.Uuid
  invoiceId       String    @db.Uuid
  organizationId  String    @db.Uuid
  amountCents     BigInt
  paymentMethod   String
  paymentRef      String?
  /// El día en que llegó el dinero (calendario de la Ciudad de México), sin hora: nadie la captura (23-15).
  paidOn          DateTime  @db.Date
  note            String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid
  undoneAt        DateTime? @db.Timestamptz(3)
  undoneByUserId  String?   @db.Uuid
  undoReason      String?

  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id])

  // -- SQL: CHECK (amountCents > 0); REVOKE DELETE ON platform_payments FROM gymflow_app
  @@index([invoiceId, createdAt])
  @@map("platform_payments")
}

/// MÓDULOS CONTRATADOS por la marca: lo decide la PLATAFORMA (ADR-037). La
/// gerencia enciende y apaga solo dentro de lo contratado. Sin fila, el
/// módulo cuenta como contratado: así las marcas que ya existían no cambian;
/// la plataforma marca explícitamente lo que NO está contratado.
model OrganizationEntitlement {
  organizationId  String   @db.Uuid
  moduleKey       String
  granted         Boolean
  reason          String?
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid
  /// Desde qué día está contratado un módulo agregado después del alta (D-39,
  /// bloque 4.9): de ahí sale el cobro por días. NULL = desde que la marca empezó.
  contractedOn    DateTime? @db.Date

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, moduleKey])
  @@map("organization_entitlements")
}

/// Lo que UNA SUCURSAL dejó de usar aunque el gimnasio lo tenga encendido
/// (ADR-036): una sede sin salón de clases, una sin tienda. Solo apaga; una
/// sede nunca enciende lo que el gimnasio tiene apagado. Una fila con
/// `enabled = true` vale lo mismo que ninguna: queda como rastro.
model BranchModuleOverride {
  organizationId  String   @db.Uuid
  branchId        String   @db.Uuid
  moduleKey       String
  enabled         Boolean
  reason          String?
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid
  /// Como en `organization_modules`, para lo apagado en una sola sucursal (3.12).
  erasureOn       DateTime? @db.Date
  erasureWarned   Int?

  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "branch_module_overrides_branch_same_org_fk")

  @@id([branchId, moduleKey])
  @@index([organizationId])
  @@map("branch_module_overrides")
}

/// GASTOS FIJOS del gimnasio: renta, nómina, luz. Sin ellos "ganancia" era
/// solo caja (UXB-02). Se registran por mes; no se borran, se anulan.
model OperatingExpense {
  id               String             @id @db.Uuid
  organizationId   String             @db.Uuid
  /// null = de todo el gimnasio (la nómina de oficina, el software).
  branchId         String?            @db.Uuid
  category         String
  description      String
  amountCents      BigInt
  /// Primer día del mes al que corresponde.
  periodMonth      DateTime           @db.Date
  createdByUserId  String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  voidedAt         DateTime?          @db.Timestamptz(3)
  voidedByUserId   String?            @db.Uuid
  voidReason       String?
  /// D-22 (3.7): «ajuste de ‹mes›». El mes CERRADO al que corresponde; el gasto
  /// cuenta en `periodMonth`, el mes en curso.
  adjustsMonth     DateTime?          @db.Date
  /// El gasto del mes cerrado que este ajuste corrige (va en negativo).
  adjustsExpenseId String?            @db.Uuid
  adjustsExpense   OperatingExpense?  @relation("ExpenseAdjustment", fields: [adjustsExpenseId], references: [id], onDelete: Restrict)
  adjustedBy       OperatingExpense[] @relation("ExpenseAdjustment")
  /// Bloque 4.3 (caja): el retiro del cajón con el que salió este «Retiro del dueño», si salió de una caja.
  cashMovement     CashMovement?
  /// D-26 (4.5): un PAGO de nómina lleva su fecha y a quién (persona del
  /// personal y su nombre al anotarlo, o solo el nombre escrito a mano).
  paidOn           DateTime?          @db.Date
  payeeUserId      String?            @db.Uuid
  payeeName        String?
  /// Salió de confirmar la propuesta `recurringDue` de un gasto que se repite.
  recurringId      String?            @db.Uuid
  recurringDue     DateTime?          @db.Date
  recurring        RecurringExpense?  @relation(fields: [recurringId], references: [id], onDelete: Restrict)

  // -- SQL: CHECK amountCents > 0, o < 0 solo si corrige un gasto (adjustsExpenseId)
  // -- SQL: UNIQUE (adjustsExpenseId) WHERE vigente: un gasto se corrige una vez
  // -- SQL: CHECK fecha y persona juntas y solo en PAYROLL; la fecha, dentro del mes que cuenta (4.5)
  // -- SQL: UNIQUE (recurringId, recurringDue) WHERE vigente: una propuesta se confirma una vez (4.5)
  @@index([organizationId, periodMonth])
  @@map("operating_expenses")
}

/// D-26 (4.5): un gasto que se repite. Es la plantilla: no cuenta en ninguna
/// cifra. Cada periodo propone un gasto «por confirmar»; nada se anota solo.
model RecurringExpense {
  id              String                 @id @db.Uuid
  organizationId  String                 @db.Uuid
  branchId        String?                @db.Uuid
  category        String
  description     String
  amountCents     BigInt
  /// MONTHLY | BIWEEKLY (día 15 y último) | WEEKLY
  frequency       String
  /// La primera fecha en que se propone.
  startsOn        DateTime               @db.Date
  payeeUserId     String?                @db.Uuid
  payeeName       String?
  createdByUserId String                 @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  endedAt         DateTime?              @db.Timestamptz(3)
  endedByUserId   String?                @db.Uuid
  endReason       String?
  expenses        OperatingExpense[]
  skips           RecurringExpenseSkip[]

  // -- SQL: sin DELETE para la aplicación; CHECK de importe, frecuencia, categoría y persona solo en PAYROLL
  @@index([organizationId, endedAt])
  @@map("recurring_expenses")
}

/// La propuesta que alguien descartó (4.5). Solo agregar.
model RecurringExpenseSkip {
  id              String           @id @db.Uuid
  organizationId  String           @db.Uuid
  recurringId     String           @db.Uuid
  dueOn           DateTime         @db.Date
  reason          String?
  skippedByUserId String           @db.Uuid
  skippedAt       DateTime         @default(now()) @db.Timestamptz(3)
  recurring       RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Restrict)

  @@unique([recurringId, dueOn])
  @@index([organizationId, dueOn])
  @@map("recurring_expense_skips")
}

/// D-25 (3.7): la gerencia pide publicar el aviso de privacidad y la dueña lo
/// firma. `bodyHash` es la huella del texto revisado: si el borrador cambia,
/// la solicitud ya no vale.
model ConsentSignatureRequest {
  id                String    @id @db.Uuid
  organizationId    String    @db.Uuid
  documentId        String    @db.Uuid
  /// PENDING | SIGNED | REJECTED | WITHDRAWN
  status            String    @default("PENDING")
  reason            String
  checklist         Json      @default("[]")
  bodyHash          String
  requestedByUserId String    @db.Uuid
  requestedAt       DateTime  @default(now()) @db.Timestamptz(3)
  resolvedByUserId  String?   @db.Uuid
  resolvedAt        DateTime? @db.Timestamptz(3)
  note              String?

  organization Organization    @relation(fields: [organizationId], references: [id])
  document     ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // -- SQL: UNIQUE (documentId) WHERE status = 'PENDING'
  @@index([organizationId, status, requestedAt], map: "consent_signature_requests_org_status_idx")
  @@map("consent_signature_requests")
}

model Session {
  id             String    @id @db.Uuid
  organizationId String?   @db.Uuid
  userId         String    @db.Uuid
  /// sha256 del identificador opaco de 256 bits. El valor en claro solo
  /// existe en la cookie del cliente.
  tokenHash      String    @unique
  deviceLabel    String?
  ip             String?
  userAgent      String?
  /// Contexto de UI, NO propiedad de datos.
  activeBranchId String?   @db.Uuid
  /// Se eleva tras superar el 2FA; hasta entonces la sesión es parcial.
  mfaSatisfied   Boolean   @default(false)
  /// Reconfirmación con el segundo factor para acciones críticas de plataforma.
  stepUpUntil    DateTime? @db.Timestamptz(3)
  /// De qué LUGAR es la sesión (D-04, bloque 4.1): COUNTER (mostrador, 12 h
  /// fijas) u OWNER_PHONE (teléfono de la dueña, 30 días que se renuevan con
  /// el uso). Se decide al entrar con la contraseña y no cambia.
  // -- SQL: CHECK (kind IN ('COUNTER', 'OWNER_PHONE'))
  kind           String    @default("COUNTER")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  revokedReason  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model MfaFactor {
  id              String    @id @db.Uuid
  userId          String    @db.Uuid
  type            String    @default("TOTP")
  /// Cifrado en reposo con MFA_ENCRYPTION_KEY (AES-256-GCM).
  secretEncrypted String
  confirmedAt     DateTime? @db.Timestamptz(3)
  lastUsedCounter BigInt?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_factors")
}

/// APPEND-ONLY. UPDATE y DELETE se REVOCAN al rol de aplicación en SQL:
/// es una garantía, no una convención.
model AuditLog {
  id               String         @id @db.Uuid
  organizationId   String         @db.Uuid
  branchId         String?        @db.Uuid
  actorUserId      String?        @db.Uuid
  actorType        AuditActorType
  action           String
  resourceType     String
  resourceId       String?        @db.Uuid
  beforeState      Json?
  afterState       Json?
  /// OBLIGATORIO en acciones sensibles (§28). Se elige de catálogo.
  reason           String?
  approvedByUserId String?        @db.Uuid
  ip               String?
  userAgent        String?
  sessionId        String?        @db.Uuid
  requestId        String?
  /// Cadena de hashes por organización: detecta edición o borrado directo
  /// en la base de datos. Un job diario la verifica (ADR-018).
  prevHash         String?
  hash             String
  /// Número de eslabón en la cadena de su organización (3.12): decide la punta
  /// y el orden de verificación, no la hora del servidor. NULL = asentado
  /// antes de que existiera; ese tramo se verifica por (at, id) y va primero.
  chainSeq         Int?
  at               DateTime       @default(now()) @db.Timestamptz(3)
  businessDate     DateTime       @db.Date

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])

  // -- SQL: REVOKE UPDATE, DELETE ON audit_logs FROM gymflow_app
  @@unique([organizationId, chainSeq])
  /// Recupera el último eslabón del tramo anterior a `chainSeq` y ordena las listas.
  @@index([organizationId, at(sort: Desc), id(sort: Desc)], map: "audit_logs_chain_tip_idx")
  @@index([organizationId, at(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, actorUserId, businessDate])
  @@map("audit_logs")
}

// ============================================================================
// SPRINT 2 — SOCIOS, PROSPECTOS Y CATÁLOGO
// ============================================================================

/// El socio pertenece a la ORGANIZACIÓN (§11.1).
/// `homeBranchId` es una PREFERENCIA: está PROHIBIDO usarlo para filtrar
/// cartera o saldo. Es el mecanismo exacto por el que BDKGYM fragmenta al
/// cliente, y existe aquí solo para reportes y asignación de coach.
model Member {
  membershipPriceChanges MembershipPriceChange[]
  privacyBatchItems      PrivacyBatchItem[]
  id                     String                  @id @db.Uuid
  organizationId         String                  @db.Uuid
  memberCode             String
  homeBranchId           String?                 @db.Uuid
  /// Coach asignado: el coach ve solo a sus socios (2026-10-09).
  coachUserId            String?                 @db.Uuid

  firstName String
  lastName  String
  /// Clave normalizada (mayúsculas, sin acentos, tokens ordenados).
  /// Denormalizada a propósito: neutraliza apellidos invertidos y permite
  /// buscar sin recalcular en cada consulta.
  nameKey   String

  phoneE164      String?
  email          String?
  birthDate      DateTime? @db.Date
  curp           String?
  photoObjectKey String?
  notes          String?

  emergencyContactName  String?
  emergencyContactPhone String?
  /// Dato SENSIBLE. Solo se guarda si el socio aceptó HEALTH_DATA, y solo lo
  /// lee quien tiene `members:health:read` (coach y gerencia, no recepción).
  healthNotes           String?

  status MemberStatus @default(ACTIVE)

  /// Derivado y cacheado SOLO para listados (ADR-005). Toda pantalla de
  /// decisión financiera lee el derivado real; un job diario reconcilia.
  balanceCentsCached BigInt    @default(0)
  balanceComputedAt  DateTime? @db.Timestamptz(3)

  /// Antigüedad del SOCIO, no de la membresía: sobrevive a bajas y altas.
  joinedAt DateTime @db.Timestamptz(3)

  /// El responsable (bloque 3.4): del celular que comparte con otro socio
  /// (D-09) y, si es menor, su tutor (D-10). SELF = el número es suyo ·
  /// MEMBER = es de otro socio · ADULT = un adulto que no es socio.
  responsibleKind      String?
  responsibleMemberId  String?   @db.Uuid
  responsibleName      String?
  responsiblePhoneE164 String?
  /// Cuándo firmó el tutor en el mostrador (D-10).
  guardianSignedAt     DateTime? @db.Timestamptz(3)

  /// Derecho de supresión (ARCO): se anonimiza la persona conservando el
  /// movimiento contable. Retención POR TIPO DE DATO, no por fila.
  anonymizedAt DateTime? @db.Timestamptz(3)

  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  organization       Organization          @relation(fields: [organizationId], references: [id])
  homeBranch         Branch?               @relation("MemberHomeBranch", fields: [homeBranchId, organizationId], references: [id, organizationId], map: "members_home_branch_same_org_fk")
  coach              User?                 @relation("MemberCoach", fields: [coachUserId, organizationId], references: [id, organizationId], map: "members_coach_same_org_fk", onDelete: Restrict, onUpdate: Cascade)
  responsibleMember  Member?               @relation("MemberResponsible", fields: [responsibleMemberId, organizationId], references: [id, organizationId], map: "members_responsible_same_org_fk", onDelete: Restrict, onUpdate: Cascade)
  responsibleOf      Member[]              @relation("MemberResponsible")
  consents           MemberConsent[]
  fromProspect       Prospect?             @relation("ProspectConversion")
  memberships        Membership[]
  visitPacks         VisitPack[]
  charges            Charge[]
  payments           Payment[]
  posSales           PosSale[]
  accessDecisions    AccessDecision[]
  attendance         AttendanceEvent[]
  trialPasses        TrialPass[]
  memberCredentials  MemberCredential[]
  portalInvites      PortalInvite[]
  memberSessions     MemberSession[]
  /// Un exsocio que vuelve manda OTRA alta digital y se vincula a su ficha.
  fromIntakes        MemberIntake[]        @relation("IntakeConversion")
  legacyCodes        MemberLegacyCode[]
  classBookings      ClassBooking[]
  workoutAssignments WorkoutAssignment[]
  bookingBlocks      ClassBookingBlock[]
  paymentMethods     PaymentMethod[]
  notices            MemberNotice[]
  followUps          FollowUp[]
  outboundMessages   OutboundMessage[]
  pushSubscriptions  MemberPushSubscription[]
  /// Lo que él mismo cambió de su contacto desde el portal (bloque 4.8; D-36).
  contactChanges     MemberContactChange[]
  /// A lo más una: la llave de la tabla es `memberId`.
  notificationPreferences MemberNotificationPreference[]
  privacyRequests    PrivacyRequest[]
  enrollments        BiometricEnrollment[]

  // -- SQL: UNIQUE (organizationId, memberCode) WHERE deletedAt IS NULL
  // El celular ya NO es único (D-09, bloque 3.4): dos socios pueden compartirlo. Índice solo para buscar.
  // -- SQL: CHECK members_responsible_kind_check (forma del responsable según `responsibleKind`)
  @@unique([id, organizationId], map: "members_id_org_key")
  @@index([organizationId, phoneE164], map: "members_org_phone_idx")
  @@index([organizationId, responsibleMemberId], map: "members_responsible_member_idx")
  /// Búsqueda de recepción con errores de captura. Se declara aquí, NO en SQL
  /// crudo: Prisma reconoce los índices GIN y los borraría como deriva.
  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "members_name_trgm_idx")
  @@index([memberCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "members_code_trgm_idx")
  @@index([organizationId, status, homeBranchId])
  @@index([organizationId, joinedAt])
  @@map("members")
}

/// Evidencia de consentimiento VERSIONADA.
/// Hay que poder demostrar quién aceptó QUÉ VERSIÓN y cuándo, mucho más allá
/// de los ~135 días de la ventana real de contracargo (docs/07 §9.2).
model MemberConsent {
  id                String      @id @db.Uuid
  organizationId    String      @db.Uuid
  memberId          String      @db.Uuid
  branchId          String?     @db.Uuid
  consentType       ConsentType
  documentVersion   String
  /// Texto exacto que se mostró al socio. Sin esto, la evidencia es una
  /// afirmación, no una prueba.
  documentText      String?
  granted           Boolean
  grantedAt         DateTime    @db.Timestamptz(3)
  revokedAt         DateTime?   @db.Timestamptz(3)
  ip                String?
  userAgent         String?
  channel           String?
  assistedByUserId  String?     @db.Uuid
  evidenceHash      String?
  /// Quién firmó POR el socio (bloque 3.4, D-10): el tutor de un menor, con su celular.
  signedByName      String?
  signedByPhoneE164 String?

  member         Member                @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "member_consents_member_same_org_fk")
  paymentMethods PaymentMethod[]
  enrollments    BiometricEnrollment[]

  @@index([organizationId, memberId, consentType, grantedAt(sort: Desc)])
  @@map("member_consents")
}

/// El prospecto SÍ nace en una sucursal: es atribución comercial de la venta.
model Prospect {
  id                String         @id @db.Uuid
  organizationId    String         @db.Uuid
  branchId          String         @db.Uuid
  firstName         String
  lastName          String
  nameKey           String
  phoneE164         String?
  email             String?
  source            String?
  status            ProspectStatus @default(NEW)
  assignedToUserId  String?        @db.Uuid
  /// Al convertirse queda ligado al socio: así se mide la conversión real.
  convertedMemberId String?        @unique @db.Uuid
  convertedAt       DateTime?      @db.Timestamptz(3)
  notes             String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  /// Bandeja (auditoría 8, bloque 2.4). `status` es la ETAPA DERIVADA de los
  /// contactos (`deriveStage` del núcleo): nadie la elige a mano. Lo que sigue
  /// se guarda junto al interesado para ordenar y paginar la bandeja en SQL.
  /// Cuándo fue su último contacto (cualquier resultado).
  lastContactAt      DateTime? @db.Timestamptz(3)
  /// El próximo paso con fecha; null = no tiene.
  nextStepOn         DateTime? @db.Date
  /// Desde qué día toca (`dueOn` del núcleo): el próximo paso o, si fue
  /// contactado y no lo tiene, el día del último contacto. Null = sin contactar.
  dueOn              DateTime? @db.Date
  /// «¿Quién lo recomendó?»: un socio, o solo su nombre.
  referredByMemberId String?   @db.Uuid
  referredByName     String?
  /// Por qué se cerró sin inscribirse (catálogo `interesadoPerdido`), cuándo y quién.
  lostReasonCode     String?
  lostReason         String?
  closedAt           DateTime? @db.Timestamptz(3)
  closedByUserId     String?   @db.Uuid

  /// D-31 (bloque 4.7). El plan que preguntó: la venta abre con él.
  interestPlanId String?   @db.Uuid
  /// Cuándo lo reabrieron por última vez: el plazo del cierre solo (60 días
  /// sin contacto, `prospectAutoCloseOn` del núcleo) vuelve a contar desde aquí.
  reopenedAt     DateTime? @db.Timestamptz(3)

  convertedMember Member?    @relation("ProspectConversion", fields: [convertedMemberId], references: [id])
  interestPlan    Plan?      @relation("ProspectInterestPlan", fields: [interestPlanId], references: [id], onDelete: SetNull, map: "prospects_interestPlanId_fkey")
  followUps       FollowUp[]

  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "prospects_name_trgm_idx")
  @@index([organizationId, branchId, status, createdAt(sort: Desc)])
  @@index([organizationId, status, dueOn], map: "prospects_org_status_due_idx")
  @@index([organizationId, phoneE164], map: "prospects_org_phone_idx")
  @@index([interestPlanId], map: "prospects_interest_plan_idx")
  @@map("prospects")
}

/// Desde qué día el cierre solo de interesados (D-31, bloque 4.7) cierra de
/// verdad en un gimnasio. La primera corrida de `prospects.auto-close` solo
/// crea esta fila, una semana adelante: así nadie amanece con la lista vacía.
model ProspectAutoCloseStart {
  organizationId String   @id @db.Uuid
  startsOn       DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("prospect_auto_close_starts")
}

/// «¿Cómo se enteró?» (bloque 2.4, 10-17): la lista que arma la gerencia. Un
/// gimnasio sin filas usa las de fábrica (`DEFAULT_PROSPECT_SOURCES`).
model ProspectSource {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name], map: "prospect_sources_org_name_key")
  @@map("prospect_sources")
}

/// Catálogo de la ORGANIZACIÓN (§25). La variación por sucursal se modela
/// aparte, NO duplicando el plan.
model Plan {
  priceChanges   PlanPriceChange[]
  id             String            @id @db.Uuid
  organizationId String            @db.Uuid
  code           String
  name           String
  description    String?
  billingModel   BillingModel
  durationUnit   DurationUnit
  durationValue  Int

  /// Precio que paga el socio, en CENTAVOS (ADR-005).
  priceCents     BigInt
  signupFeeCents BigInt @default(0)
  currency       String @default("MXN") @db.Char(3)

  /// Desglose fiscal. PENDIENTE Q-B-04: no se sabe si los precios son con
  /// IVA incluido ni si las cuotas causan IVA. Se modela paramétrico para
  /// que la respuesta NO obligue a migrar datos:
  ///   · taxRateBps = null  -> no se desglosa (realidad de hoy)
  ///   · priceIncludesTax   -> decide si el impuesto se resta o se suma
  taxRateBps       Int?
  priceIncludesTax Boolean @default(true)

  branchAccessScope BranchAccessScope @default(ALL_BRANCHES)
  accessTimeWindows Json?

  /// Solo para billingModel = VISIT_PACK
  visitsIncluded    Int?
  visitValidityDays Int?

  /// ¿La cuota incluye las clases con cupo, o cada una se paga aparte?
  /// Falso por defecto a propósito: regalar clases por omisión es un error
  /// que solo se descubre al cuadrar el mes.
  includesClasses      Boolean  @default(false)
  /// Con `includesClasses`: cuáles. Vacío = todas las que se pueden incluir
  /// en un plan (`ClassType.includableInPlans`). 2026-10-09.
  includedClassTypeIds String[] @default([]) @db.Uuid

  defaultGraceDays     Int     @default(5)
  allowFreeze          Boolean @default(true)
  maxFreezeDaysPerYear Int     @default(30)
  minFreezeDays        Int     @default(7)
  autoRenewDefault     Boolean @default(true)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization       Organization             @relation(fields: [organizationId], references: [id])
  branchAvailability PlanBranchAvailability[]
  memberships        Membership[]
  /// Interesados que preguntaron por este plan (D-31, bloque 4.7).
  interestedProspects Prospect[] @relation("ProspectInterestPlan")

  // -- SQL: UNIQUE (organizationId, code) WHERE deletedAt IS NULL
  @@unique([id, organizationId], map: "plans_id_org_key")
  // -- SQL: CHECK de coherencia entre billingModel y los campos de visitas
  @@index([organizationId, isActive, billingModel])
  @@map("plans")
}

/// EXCEPCIÓN DOCUMENTADA (§25): precio y disponibilidad por sucursal sin
/// fragmentar el catálogo en un plan por sede.
model PlanBranchAvailability {
  planId             String  @db.Uuid
  branchId           String  @db.Uuid
  organizationId     String  @db.Uuid
  isAvailable        Boolean @default(true)
  priceOverrideCents BigInt?

  plan   Plan   @relation(fields: [planId, organizationId], references: [id, organizationId], map: "pba_plan_same_org_fk")
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "pba_branch_same_org_fk")

  @@id([planId, branchId])
  @@index([organizationId, branchId])
  @@map("plan_branch_availability")
}

/// Contador del código legible de socio, por sucursal.
/// Tabla en vez de secuencia de PostgreSQL: el contador debe poder
/// reiniciarse o ajustarse tras la migración de BDKGYM sin tocar DDL.
/// Contador de códigos de socio.
///
/// Indexado por PREFIJO, no por sucursal. La unicidad del código de socio es
/// `(organización, código)`, y el código es `PREFIJO-NNNNN`: si el contador
/// fuera por sucursal, dos sedes que comparten prefijo emitirían el mismo
/// código, y archivar una sede y reutilizar su prefijo chocaría contra los
/// códigos que esa sede ya emitió. El contador tiene que vivir en el mismo
/// espacio que la unicidad que protege.
model MemberCodeCounter {
  organizationId String   @db.Uuid
  /// Las tres primeras letras del código de sucursal.
  prefix         String   @db.VarChar(3)
  lastSequence   Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@id([organizationId, prefix])
  @@map("member_code_counters")
}

// ============================================================================
// SPRINT 3 — MOTOR DE MEMBRESÍAS
// ============================================================================

/// Contrato vigente socio↔plan. NUNCA se confunde con el socio (§15):
/// un socio puede existir sin membresía activa, y eso es lo que permite
/// conservar expediente, historial y saldo tras una baja.
model Membership {
  priceChanges   MembershipPriceChange[]
  /// Bloque 4.20 (P-14): cuándo llegó cada aumento guardado «por llegar».
  priceApplications MembershipPriceApplication[]
  id             String                  @id @db.Uuid
  organizationId String                  @db.Uuid
  memberId       String                  @db.Uuid
  planId         String                  @db.Uuid
  /// Atribución de VENTA. No condiciona dónde entra ni dónde paga.
  soldAtBranchId String?                 @db.Uuid
  status         MembershipStatus        @default(PENDING)

  startDate          DateTime  @db.Date
  /// Intervalo SEMIABIERTO [start, end): el fin de un periodo ES el inicio
  /// del siguiente. Sin días duplicados ni huecos.
  currentPeriodStart DateTime  @db.Date
  currentPeriodEnd   DateTime  @db.Date
  /// Ancla 1..31 fijada en el alta. NUNCA se recalcula desde la fecha
  /// efectiva anterior: eso produce deriva irreversible (ADR-006).
  billingAnchorDay   Int
  graceUntil         DateTime? @db.Date

  autoRenew Boolean @default(true)

  /// Cupo de congelamiento consumido en el año natural en curso.
  frozenDaysUsedThisYear Int       @default(0)
  frozenDaysUsedYear     Int?
  frozenSince            DateTime? @db.Date
  frozenUntil            DateTime? @db.Date

  /// CANCELED y EXPIRED son terminales: reactivar crea una membresía NUEVA,
  /// enlazada aquí. La antigüedad vive en Member.joinedAt, no en la membresía.
  replacesMembershipId String? @unique @db.Uuid

  canceledAt         DateTime? @db.Timestamptz(3)
  cancellationReason String?
  endedAt            DateTime? @db.Timestamptz(3)

  /// Clave de la VENTA que la creó (DM-08): el reintento de un mostrador con
  /// la red caída devuelve la misma venta en vez de "ya tiene una vigente".
  saleKey              String?
  /// Precio pactado al vender (DM-05): las cuotas se cobran a este precio, no al de lista de hoy.
  agreedPriceCents     BigInt?
  /// «Conserva su precio» (D-19, bloque 3.6): un cambio de precio del plan no la toca salvo que alguien lo decida.
  priceProtected       Boolean @default(false)
  priceProtectedReason String?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  member       Member                   @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "memberships_member_same_org_fk")
  plan         Plan                     @relation(fields: [planId, organizationId], references: [id, organizationId], map: "memberships_plan_same_org_fk")
  soldAtBranch Branch?                  @relation("MembershipSoldAt", fields: [soldAtBranchId, organizationId], references: [id, organizationId], map: "memberships_branch_same_org_fk")
  replaces     Membership?              @relation("MembershipChain", fields: [replacesMembershipId], references: [id])
  replacedBy   Membership?              @relation("MembershipChain")
  branchAccess MembershipBranchAccess[]
  events       MembershipEvent[]
  charges      Charge[]

  @@unique([id, organizationId], map: "memberships_id_org_key")
  @@unique([organizationId, saleKey], map: "memberships_org_salekey_key")
  // -- SQL: UNIQUE (memberId) WHERE status IN ('PENDING','TRIALING','ACTIVE','PAST_DUE','FROZEN')
  //         ^^^ CRÍTICO: una sola membresía vigente por socio.
  // -- SQL: CHECK (billingAnchorDay BETWEEN 1 AND 31)
  // -- SQL: CHECK (currentPeriodEnd > currentPeriodStart)
  @@index([organizationId, status, currentPeriodEnd])
  @@index([organizationId, memberId, startDate(sort: Desc)])
  @@index([organizationId, status, graceUntil])
  @@map("memberships")
}

/// Qué sucursales habilita esta membresía cuando el plan usa LISTED_BRANCHES.
model MembershipBranchAccess {
  membershipId   String @db.Uuid
  branchId       String @db.Uuid
  organizationId String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "mba_branch_same_org_fk")

  @@id([membershipId, branchId])
  @@index([organizationId, branchId])
  @@map("membership_branch_access")
}

/// Bitácora de transiciones. Append-only: es la historia del contrato.
model MembershipEvent {
  id             String              @id @db.Uuid
  organizationId String              @db.Uuid
  membershipId   String              @db.Uuid
  branchId       String?             @db.Uuid
  eventType      MembershipEventType
  fromStatus     MembershipStatus?
  toStatus       MembershipStatus
  payload        Json                @default("{}")
  actorUserId    String?             @db.Uuid
  reason         String?
  at             DateTime            @default(now()) @db.Timestamptz(3)
  businessDate   DateTime            @db.Date

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([organizationId, membershipId, at(sort: Desc)])
  @@map("membership_events")
}

/// Paquete de visitas prepagado: INGRESO DIFERIDO (ADR-024).
/// Se cobra hoy y se consume después, así que no es ingreso el día del cobro.
model VisitPack {
  id              String          @id @db.Uuid
  organizationId  String          @db.Uuid
  memberId        String          @db.Uuid
  planId          String?         @db.Uuid
  soldAtBranchId  String?         @db.Uuid
  visitsPurchased Int
  purchasedOn     DateTime        @db.Date
  expiresOn       DateTime?       @db.Date
  status          VisitPackStatus @default(PENDING_PAYMENT)
  /// La caducidad es un EVENTO CON FECHA, no una consulta: sin esto no hay
  /// registro de cuándo ni cuánto se perdió, y el reconocimiento de ingreso
  /// es imposible (ADR-024).
  expiredAt       DateTime?       @db.Timestamptz(3)
  /// Cargo que financió el paquete.
  ///
  /// Sin este enlace, el ingreso diferido sería una estimación: habría que
  /// valorar la visita con el precio de lista del plan, que no es lo que el
  /// socio pagó si hubo descuento o precio por sucursal. El reconocimiento de
  /// ingreso exige el importe REAL (ADR-024).
  chargeId        String?         @db.Uuid
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  member  Member             @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "visit_packs_member_same_org_fk")
  entries VisitLedgerEntry[]

  @@unique([id, organizationId], map: "visit_packs_id_org_key")
  @@unique([chargeId], map: "visit_packs_charge_key")
  // -- SQL: CHECK (visitsPurchased > 0)
  @@index([organizationId, memberId, status])
  @@index([organizationId, status, expiresOn])
  @@map("visit_packs")
}

/// LIBRO DE MOVIMIENTOS del saldo de visitas, nunca un contador mutable.
/// Un contador que se decrementa no permite auditar por qué a un socio le
/// faltan visitas; con libro, cada consumo tiene fecha, sucursal y origen.
model VisitLedgerEntry {
  id                String               @id @db.Uuid
  organizationId    String               @db.Uuid
  visitPackId       String               @db.Uuid
  branchId          String?              @db.Uuid
  /// Clave de idempotencia del consumo: el id de la ASISTENCIA que lo causó
  /// (5-24, auditoría 8; hasta el 2026-11-18 se guardaba el de la decisión y
  /// la migración `visita_con_id_de_asistencia` corrigió lo viejo). La llave
  /// foránea contra AttendanceEvent queda pendiente; el índice único ya protege.
  attendanceEventId String?              @db.Uuid
  entryType         VisitLedgerEntryType
  delta             Int
  reason            String?
  createdByUserId   String?              @db.Uuid
  at                DateTime             @default(now()) @db.Timestamptz(3)
  businessDate      DateTime             @db.Date

  visitPack VisitPack @relation(fields: [visitPackId, organizationId], references: [id, organizationId], map: "vle_pack_same_org_fk")

  // -- SQL: UNIQUE (visitPackId, attendanceEventId) WHERE attendanceEventId IS NOT NULL
  //         ^^^ ANTI DOBLE CONSUMO: un doble paso del torniquete o una
  //             resincronización offline consumirían dos visitas por una entrada.
  // -- SQL: CHECK (delta <> 0)
  // -- SQL: CHECK de coherencia entre entryType y el signo de delta
  @@index([visitPackId, at])
  @@map("visit_ledger_entries")
}

// ════════════════════════════════════════════════════════════════════════════
// SPRINT 4 · LIBRO FINANCIERO
//
// Dos entidades, nunca una sola: `Charge` es la OBLIGACIÓN y `Payment` es el
// MOVIMIENTO DE DINERO. Se relacionan N:M porque la realidad del mostrador lo
// es: un socio abona $200 a cuenta de dos mensualidades atrasadas, o paga de
// un golpe el trimestre completo. Un booleano `paid` en el cargo haría
// imposible representar cualquiera de los dos casos (ADR-011).
// ════════════════════════════════════════════════════════════════════════════

enum ChargeType {
  MEMBERSHIP_PERIOD
  SIGNUP_FEE
  VISIT_PACK
  DAY_PASS
  CLASS_SINGLE
  NO_SHOW_PENALTY
  POS_SALE
  PRORATION_ADJUSTMENT
  OPENING_BALANCE
  MANUAL_ADJUSTMENT
}

enum ChargeStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
}

enum PaymentMethodType {
  CASH
  CARD_TERMINAL
  CARD_ON_FILE
  SPEI_TRANSFER
  OXXO_REF
  CREDIT_NOTE
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  /// 3-D Secure pendiente: el socio tiene que autenticar.
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  /// Timeout sin respuesta. NO es un fallo: bloquea reintentos hasta
  /// conciliar, y es lo único que impide el doble cobro (§11.6).
  UNKNOWN
  CANCELED
  REVERSED
}

enum AdjustmentType {
  DISCOUNT
  WAIVER
  LATE_FEE
  CORRECTION
}

enum BillingCycleStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Ejecución del job de generación de cargos.
///
/// Existe para que una pregunta operativa tenga respuesta: "¿de dónde salió
/// este cargo?". Sin esto, un cargo generado de más es indistinguible de uno
/// capturado a mano, y no hay forma de auditar una corrida completa.
model BillingCycle {
  id             String             @id @db.Uuid
  organizationId String             @db.Uuid
  /// Fecha de negocio de la corrida en la zona de la organización.
  runDate        DateTime           @db.Date
  status         BillingCycleStatus @default(RUNNING)

  chargesCreated Int    @default(0)
  chargesSkipped Int    @default(0)
  amountCents    BigInt @default(0)

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  error      String?

  organization Organization @relation(fields: [organizationId], references: [id])
  charges      Charge[]

  @@unique([id, organizationId], map: "billing_cycles_id_org_key")
  // -- SQL: UNIQUE (organizationId, runDate) WHERE status <> 'FAILED'
  //         ^^^ Una sola corrida válida por día: reejecutar no duplica.
  @@index([organizationId, runDate(sort: Desc)])
  @@map("billing_cycles")
}

/// La OBLIGACIÓN. Cuelga del SOCIO, no de la membresía: un day pass, una venta
/// de mostrador o un saldo migrado existen sin contrato vigente. Por eso
/// `membershipId` es OPCIONAL, y por eso no se puede modelar como una columna
/// dentro de `Membership`.
model Charge {
  id             String  @id @db.Uuid
  organizationId String  @db.Uuid
  memberId       String  @db.Uuid
  /// Opcional A PROPÓSITO: ver el comentario del modelo.
  membershipId   String? @db.Uuid
  /// Dónde se originó. Necesario para el corte por sucursal.
  branchId       String? @db.Uuid
  billingCycleId String? @db.Uuid

  chargeType ChargeType
  status     ChargeStatus @default(OPEN)
  concept    String

  /// Todo en CENTAVOS (ADR-005). Jamás un float toca dinero.
  subtotalCents BigInt
  taxCents      BigInt @default(0)
  discountCents BigInt @default(0)
  /// = subtotal + impuesto − descuento. Garantizado por CHECK.
  amountCents   BigInt
  currency      String @default("MXN") @db.Char(3)

  /// Mantenidos en la MISMA transacción que la asignación, no por un job:
  /// el saldo de un cargo no puede ir por detrás de su cobro.
  allocatedCents BigInt @default(0)
  adjustedCents  BigInt @default(0)

  /// Periodo que cubre el cargo, semiabierto [start, end) como la membresía.
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  issuedAt DateTime? @db.Timestamptz(3)
  dueDate  DateTime  @db.Date

  /// DETERMINISTA y derivada del dominio (no del reloj): es lo que hace que
  /// reejecutar el job no duplique cargos. BullMQ es *at-least-once*.
  idempotencyKey String?

  voidedAt       DateTime? @db.Timestamptz(3)
  voidReason     String?
  writtenOffAt   DateTime? @db.Timestamptz(3)
  writeOffReason String?
  /// D-18 (bloque 4.4): el día en que esta deuda se dio por PERDIDA (su
  /// membresía llevó suspendida el plazo del gimnasio). No es condonación ni
  /// anulación: conserva estado y saldo, sigue en el estado de cuenta y se
  /// puede cobrar; solo deja de sumarse en «Por cobrar».
  lostOn         DateTime? @db.Date

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  member       Member              @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "charges_member_same_org_fk")
  membership   Membership?         @relation(fields: [membershipId, organizationId], references: [id, organizationId], map: "charges_membership_same_org_fk")
  branch       Branch?             @relation("ChargeBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "charges_branch_same_org_fk")
  billingCycle BillingCycle?       @relation(fields: [billingCycleId, organizationId], references: [id, organizationId], map: "charges_cycle_same_org_fk")
  allocations  PaymentAllocation[]
  adjustments  ChargeAdjustment[]
  posSale      PosSale?
  classBooking ClassBooking?

  @@unique([id, organizationId], map: "charges_id_org_key")
  // -- SQL: UNIQUE (organizationId, idempotencyKey) WHERE idempotencyKey IS NOT NULL
  //         ^^^ CRÍTICO: la barrera real contra cargos duplicados.
  // -- SQL: CHECK (amountCents = subtotalCents + taxCents - discountCents)
  // -- SQL: CHECK (subtotalCents >= 0 AND taxCents >= 0 AND discountCents >= 0 AND amountCents >= 0)
  // -- SQL: CHECK (allocatedCents >= 0 AND adjustedCents >= 0)
  // -- SQL: CHECK (allocatedCents + adjustedCents <= amountCents)
  //         ^^^ Impide cobrar de más contra un cargo: el excedente DEBE
  //             quedar como saldo a favor, nunca como cargo negativo.
  // -- SQL: CHECK (periodEnd > periodStart)
  // -- SQL: CHECK (chargeType = 'MEMBERSHIP_PERIOD' -> membershipId IS NOT NULL)
  @@index([organizationId, memberId, dueDate(sort: Desc)])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, branchId, createdAt(sort: Desc)])
  @@index([membershipId, periodStart])
  @@map("charges")
}

/// Modificación de una obligación SIN tocar el importe original.
/// Append-only: un descuento aplicado y luego retirado deja dos asientos, no
/// un `UPDATE` que borra la huella de quién lo autorizó.
model ChargeAdjustment {
  id               String         @id @db.Uuid
  organizationId   String         @db.Uuid
  chargeId         String         @db.Uuid
  adjustmentType   AdjustmentType
  /// Positivo = REDUCE la deuda (descuento/condonación).
  /// Negativo = la AUMENTA (recargo por mora).
  amountCents      BigInt
  /// Motivo de CATÁLOGO (§17). Un campo libre produce "desc", "autorizado" y
  /// nada analizable; con catálogo, "¿cuánto nos cuesta la promoción de
  /// estudiante?" tiene respuesta. Nulo solo en los ajustes anteriores al
  /// Sprint 5: por eso el CHECK entra como NOT VALID.
  reasonCode       String?
  reason           String
  approvedByUserId String?        @db.Uuid
  createdByUserId  String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  charge Charge @relation(fields: [chargeId, organizationId], references: [id, organizationId], map: "adjustments_charge_same_org_fk")

  // -- SQL: CHECK (amountCents <> 0)
  // -- SQL: CHECK de coherencia entre adjustmentType y el signo
  // -- SQL: REVOKE UPDATE, DELETE (append-only)
  @@index([organizationId, chargeId])
  @@map("charge_adjustments")
}

/// El MOVIMIENTO DE DINERO. Nunca se edita ni se borra: se contra-asienta.
model Payment {
  id             String  @id @db.Uuid
  organizationId String  @db.Uuid
  memberId       String  @db.Uuid
  branchId       String? @db.Uuid

  method PaymentMethodType
  status PaymentStatus     @default(INITIATED)

  /// Negativo SOLO si es un contra-asiento (garantizado por CHECK).
  amountCents    BigInt
  currency       String @default("MXN") @db.Char(3)
  /// Lo no aplicado a ningún cargo = SALDO A FAVOR del socio.
  unappliedCents BigInt @default(0)

  /// Idempotencia de cobro. Contra el doble clic en el mostrador y contra
  /// el reintento de un webhook.
  idempotencyKey String?
  /// Referencia del procesador (autorización, folio SPEI, referencia OXXO).
  externalRef    String?
  processorName  String?

  receivedAt   DateTime @default(now()) @db.Timestamptz(3)
  businessDate DateTime @db.Date

  /// Turno al que se imputa. Nulo cuando el cobro no pasa por mostrador
  /// (portal, domiciliación, transferencia conciliada después).
  cashSessionId String? @db.Uuid
  /// Folio de mostrador, legible en voz alta. Solo para cobros en caja.
  folio         String?

  /// Contra-asiento: enlaza al pago original. Un pago admite UNA reversa
  /// total o VARIOS reembolsos parciales (BE2-01); la unicidad de la reversa
  /// la impone un índice parcial en SQL sobre `isRefund = false`.
  reversesPaymentId String? @db.Uuid
  reversalReason    String?
  /// El contra-asiento es un reembolso (parcial o total), no una reversa.
  isRefund          Boolean @default(false)

  failureCode   String?
  failureReason String?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  member       Member              @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "payments_member_same_org_fk")
  branch       Branch?             @relation("PaymentBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "payments_branch_same_org_fk")
  cashSession  CashSession?        @relation(fields: [cashSessionId, organizationId], references: [id, organizationId], map: "payments_session_same_org_fk")
  reverses     Payment?            @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedBy   Payment[]           @relation("PaymentReversal")
  allocations  PaymentAllocation[]
  attempts     PaymentAttempt[]
  refunds      Refund[]
  chargebacks  Chargeback[]

  /// Tarjeta con la que se cobró. Nulo en efectivo, terminal y transferencia.
  paymentMethodId String?        @db.Uuid
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@unique([id, organizationId], map: "payments_id_org_key")
  // -- SQL: UNIQUE (organizationId, idempotencyKey) WHERE idempotencyKey IS NOT NULL
  // -- SQL: CHECK (amountCents <> 0)
  // -- SQL: CHECK (amountCents < 0) = (reversesPaymentId IS NOT NULL)
  // -- SQL: CHECK (unappliedCents >= 0 AND unappliedCents <= abs(amountCents))
  // -- SQL: REVOKE DELETE (un pago jamás se borra: se revierte)
  @@index([organizationId, memberId, receivedAt(sort: Desc)])
  @@index([organizationId, branchId, businessDate])
  // -- SQL: UNIQUE (organizationId, folio) WHERE folio IS NOT NULL
  @@index([organizationId, status, receivedAt])
  @@index([cashSessionId, receivedAt])
  /// Movimientos y ganancia por día: se recorre por fecha de negocio.
  @@index([organizationId, businessDate])
  /// Contra-asientos de un pago (reversa y reembolsos).
  @@index([reversesPaymentId])
  @@map("payments")
}

/// La tabla que hace posible el N:M. Aquí vive la verdad del "cuánto de este
/// pago cubre cuál obligación".
model PaymentAllocation {
  id             String @id @db.Uuid
  organizationId String @db.Uuid
  paymentId      String @db.Uuid
  chargeId       String @db.Uuid
  amountCents    BigInt

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId, organizationId], references: [id, organizationId], map: "alloc_payment_same_org_fk")
  charge  Charge  @relation(fields: [chargeId, organizationId], references: [id, organizationId], map: "alloc_charge_same_org_fk")

  /// Un pago se aplica UNA vez a cada cargo; para abonar más, se amplía la
  /// asignación existente, no se crea una segunda.
  @@unique([paymentId, chargeId], map: "alloc_payment_charge_key")
  // -- SQL: CHECK (amountCents <> 0)
  // -- SQL: REVOKE DELETE (desasignar es un asiento, no un borrado)
  @@index([organizationId, chargeId])
  @@map("payment_allocations")
}

// ════════════════════════════════════════════════════════════════════════════
// SPRINT 5 · CAJA Y CORTE DE TURNO
//
// El corte es el punto de MAYOR exposición a fuga del sistema, porque el
// efectivo domina el cobro. La sesión cuelga de una CAJA, no de una sucursal
// (ADR-013): tres cajeros compartiendo turno en una sede hacen que un faltante
// no sea de nadie, y una diferencia que no es de nadie deja de investigarse.
// ════════════════════════════════════════════════════════════════════════════

enum CashSessionStatus {
  OPEN
  CLOSED
  /// Cuadrada contra el depósito bancario. Llega con el Sprint 13.
  RECONCILED
}

enum CashMovementType {
  FLOAT_IN
  WITHDRAWAL
  EXPENSE
  DEPOSIT
  CORRECTION
}

/// Punto de cobro físico. Una sucursal puede tener varias.
model CashRegister {
  id             String  @id @db.Uuid
  organizationId String  @db.Uuid
  branchId       String  @db.Uuid
  /// Corto y estable: entra en el folio que el socio lee por teléfono.
  code           String
  name           String
  isActive       Boolean @default(true)

  /// Contador de folio POR CAJA. Puede tener huecos si una transacción se
  /// revierte, y es correcto: un folio sin huecos obligaría a reutilizar
  /// números, que es peor. No es fiscal —no se factura— sino operativo.
  folioCounter Int @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  branch       Branch        @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "registers_branch_same_org_fk")
  sessions     CashSession[]
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@unique([id, organizationId], map: "cash_registers_id_org_key")
  // -- SQL: UNIQUE (branchId, code) WHERE deletedAt IS NULL
  @@index([organizationId, branchId, isActive])
  @@map("cash_registers")
}

/// Turno de una caja.
model CashSession {
  id             String            @id @db.Uuid
  organizationId String            @db.Uuid
  branchId       String            @db.Uuid
  cashRegisterId String            @db.Uuid
  openedByUserId String            @db.Uuid
  closedByUserId String?           @db.Uuid
  shiftLabel     String?
  businessDate   DateTime          @db.Date
  status         CashSessionStatus @default(OPEN)

  openingFloatCents     BigInt
  /// Se calculan AL CERRAR. Mientras la sesión está abierta son nulos a
  /// propósito: mostrar el esperado antes del conteo haría que el cajero
  /// tecleara esa cifra y el corte dejaría de medir nada.
  expectedCashCents     BigInt?
  countedCashCents      BigInt?
  /// contado − esperado. Negativo = FALTA dinero.
  varianceCents         BigInt?
  /// OBLIGATORIO si la diferencia no es cero. También si SOBRA: el sobrante
  /// sistemático es la firma de un cobro no registrado.
  varianceReason        String?
  /// Corte ciego: el PRIMER conteo queda fijo aunque se cuente otra vez
  /// (UXA-02). Sin esto, ver cuánto debía haber y recontar tapaba un faltante.
  firstCountedCashCents BigInt?
  countAttempts         Int     @default(0)

  openedAt DateTime  @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)

  /// D-17 (fase 4, bloque 4.3). El descuadre es de quien abrió (`openedByUserId`).
  /// 'PENDING': cerró con más de $20 de diferencia y la gerencia no lo ha
  /// revisado; 'REVIEWED': lo cerró con su nota. Nulo: no hay nada que revisar.
  varianceStatus           String?
  varianceReviewedByUserId String?   @db.Uuid
  varianceReviewedAt       DateTime? @db.Timestamptz(3)
  varianceReviewNote       String?

  cashRegister CashRegister   @relation(fields: [cashRegisterId, organizationId], references: [id, organizationId], map: "sessions_register_same_org_fk")
  branch       Branch         @relation("CashSessionBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "sessions_branch_same_org_fk")
  movements    CashMovement[]
  payments     Payment[]
  posSales     PosSale[]
  posSaleReturns PosSaleReturn[]

  @@unique([id, organizationId], map: "cash_sessions_id_org_key")
  // -- SQL: UNIQUE (cashRegisterId) WHERE status = 'OPEN'
  //         ^^^ una sola sesión abierta POR CAJA
  // -- SQL: CHECK (status = 'OPEN' OR countedCashCents IS NOT NULL)
  // -- SQL: CHECK (varianceCents IS NULL OR varianceCents = 0 OR varianceReason IS NOT NULL)
  // -- SQL: CHECK (openingFloatCents >= 0)
  // -- SQL: CHECK varianceStatus en ('PENDING','REVIEWED'), solo en un turno cortado con diferencia,
  //         y 'REVIEWED' con quién, cuándo y nota (bloque 4.3)
  @@index([organizationId, branchId, businessDate])
  @@index([organizationId, status, openedAt])
  @@index([organizationId, varianceStatus], map: "cash_sessions_org_variance_status_idx")
  @@map("cash_sessions")
}

/// Entradas y salidas de efectivo que NO son cobros.
/// Append-only: un retiro borrado es exactamente el fraude que el corte busca.
model CashMovement {
  id             String           @id @db.Uuid
  organizationId String           @db.Uuid
  cashSessionId  String           @db.Uuid
  movementType   CashMovementType
  /// Ya FIRMADO respecto al cajón: positivo entra, negativo sale. Guardarlo
  /// firmado hace que el efectivo esperado sea una suma directa.
  amountCents    BigInt
  reason         String

  createdByUserId  String  @db.Uuid
  approvedByUserId String? @db.Uuid

  at           DateTime @default(now()) @db.Timestamptz(3)
  /// Día de negocio de la SEDE en que se hizo (DM-10): un turno que cruza la
  /// medianoche reparte sus movimientos entre los dos días, como los pagos.
  businessDate DateTime @db.Date

  /// «Retiro del dueño» que salió del cajón (bloque 4.3): su anotación en
  /// Movimientos, creada en la misma transacción. Nulo en todo lo demás.
  expenseId String? @unique(map: "cash_movements_expense_key") @db.Uuid

  cashSession CashSession       @relation(fields: [cashSessionId, organizationId], references: [id, organizationId], map: "movements_session_same_org_fk")
  expense     OperatingExpense? @relation(fields: [expenseId], references: [id], onDelete: Restrict, map: "cash_movements_expense_fk")

  // -- SQL: CHECK (amountCents <> 0)
  // -- SQL: CHECK de coherencia entre movementType y el signo
  // -- SQL: CHECK (length(btrim(reason)) >= 3)
  // -- SQL: REVOKE UPDATE, DELETE (append-only)
  @@index([organizationId, cashSessionId, at])
  @@index([organizationId, businessDate], map: "cash_movements_org_business_date_idx")
  @@map("cash_movements")
}

// ════════════════════════════════════════════════════════════════════════════
// SPRINT 6 · PUNTO DE VENTA
//
// Entra al MVP porque BLOQUEA EL CUTOVER, no por su valor intrínseco: si el
// mostrador sigue cobrando el refresco en BDKGYM, el corte nunca cuadra en
// GymFlow y no se puede apagar el sistema viejo. De ahí el alcance: catálogo
// plano, sin variantes, sin proveedores, sin órdenes de compra.
// ════════════════════════════════════════════════════════════════════════════

enum PosSaleStatus {
  COMPLETED
  VOIDED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  SALE_VOIDED
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SHRINKAGE
}

model Product {
  id               String  @id @db.Uuid
  organizationId   String  @db.Uuid
  sku              String
  name             String
  priceCents       BigInt
  currency         String  @default("MXN") @db.Char(3)
  /// Lo que le cuesta al gimnasio (D-21, opcional): sin costo, el Tablero cuenta la venta completa.
  costCents        BigInt?
  /// Precio para socios con membresía vigente (D-21, opcional): sin él, todos pagan `priceCents`.
  memberPriceCents BigInt?
  /// Un servicio (p. ej. alquiler de casillero) no lleva existencias.
  tracksInventory  Boolean @default(true)
  isActive         Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  saleLines    PosSaleLine[]
  stock        InventoryStock[]
  movements    InventoryMovement[]

  @@unique([id, organizationId], map: "products_id_org_key")
  // -- SQL: UNIQUE (organizationId, sku) WHERE deletedAt IS NULL
  // -- SQL: CHECK (priceCents >= 0)
  @@index([organizationId, isActive])
  @@map("products")
}

/// Venta de mostrador. SIEMPRE pertenece a un turno de caja: sin eso el
/// producto entra al sistema sin entrar a ningún cajón y el corte deja de
/// cuadrar contra la realidad física.
model PosSale {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  cashSessionId  String        @db.Uuid
  /// Nulo = venta a público general. El refresco se le vende a cualquiera.
  memberId       String?       @db.Uuid
  status         PosSaleStatus @default(COMPLETED)

  totalCents BigInt
  currency   String @default("MXN") @db.Char(3)

  /// Cómo se pagó. Nulo SOLO si va a la cuenta del socio (`chargeId`).
  method         PaymentMethodType?
  /// Venta cargada a la cuenta: el dinero no entra hoy al cajón.
  chargeId       String?            @unique @db.Uuid
  /// Autorización de la terminal o clave de rastreo de la transferencia (UXA-09).
  externalRef    String?
  folio          String?
  /// La genera el cliente una vez por venta: un doble clic o un reintento de
  /// red devuelve la misma venta en lugar de cobrar dos veces.
  idempotencyKey String?

  voidedByUserId String?   @db.Uuid
  voidReason     String?
  voidedAt       DateTime? @db.Timestamptz(3)

  soldByUserId String   @db.Uuid
  soldAt       DateTime @default(now()) @db.Timestamptz(3)
  businessDate DateTime @db.Date

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch        @relation("PosSaleBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "pos_sales_branch_same_org_fk")
  cashSession  CashSession   @relation(fields: [cashSessionId, organizationId], references: [id, organizationId], map: "pos_sales_session_same_org_fk")
  member       Member?       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "pos_sales_member_same_org_fk")
  charge       Charge?       @relation(fields: [chargeId, organizationId], references: [id, organizationId], map: "pos_sales_charge_same_org_fk")
  lines        PosSaleLine[]
  // Bloque 3.5 (D-13): «por corregir» y la devolución de otro día.
  // (A lo más una de cada una: lo garantiza el índice único por venta.)
  flags        PosSaleFlag[]
  saleReturns  PosSaleReturn[]

  @@unique([id, organizationId], map: "pos_sales_id_org_key")
  /// Soporte de la relación 1:1 con el cargo, que además impide que dos ventas
  /// se carguen al mismo cargo.
  @@unique([chargeId, organizationId], map: "pos_sales_charge_org_key")
  @@unique([organizationId, idempotencyKey], map: "pos_sales_idempotency_key")
  // -- SQL: CHECK (status <> 'VOIDED' OR voidReason IS NOT NULL)
  // -- SQL: CHECK ((chargeId IS NULL) = (method IS NOT NULL))
  //         ^^^ o se cobra ahora, o va a la cuenta. Nunca las dos, nunca ninguna.
  // -- SQL: CHECK (totalCents >= 0)
  // -- SQL: UNIQUE (organizationId, folio) WHERE folio IS NOT NULL
  // -- SQL: REVOKE DELETE (una venta se anula, no se borra)
  @@index([organizationId, branchId, businessDate])
  @@index([cashSessionId, soldAt])
  @@index([organizationId, memberId, soldAt(sort: Desc)])
  @@map("pos_sales")
}

/// El precio se CONGELA en la línea. Derivarlo del producto al leer haría que
/// una venta de hace tres meses cambiara de importe al subir el precio.
model PosSaleLine {
  id             String  @id @db.Uuid
  organizationId String  @db.Uuid
  posSaleId      String  @db.Uuid
  productId      String  @db.Uuid
  quantity       Int
  unitPriceCents BigInt
  lineTotalCents BigInt
  /// Lo que costaba el producto el día de la venta (D-21); nulo si no tenía costo capturado.
  unitCostCents  BigInt?
  /// PUBLIC · MEMBER: a qué precio salió la línea.
  priceKind      String  @default("PUBLIC")

  posSale PosSale @relation(fields: [posSaleId, organizationId], references: [id, organizationId], map: "pos_lines_sale_same_org_fk")
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId], map: "pos_lines_product_same_org_fk")

  // -- SQL: CHECK (quantity > 0)
  // -- SQL: CHECK (lineTotalCents = unitPriceCents * quantity)
  // -- SQL: CHECK (unitPriceCents >= 0)
  @@index([posSaleId])
  @@index([organizationId, productId])
  @@map("pos_sale_lines")
}

/// «Por corregir» (D-13, bloque 3.5): recepción no anula una venta, avisa. La
/// gerencia la anula el mismo día, registra su devolución otro día (con la
/// firma de la dueña) o descarta el aviso. Una fila por venta: volver a
/// marcarla reabre la misma.
model PosSaleFlag {
  id               String    @id @db.Uuid
  organizationId   String    @db.Uuid
  posSaleId        String    @unique(map: "pos_sale_flags_sale_key") @db.Uuid
  branchId         String    @db.Uuid
  reason           String
  flaggedByUserId  String    @db.Uuid
  flaggedAt        DateTime  @default(now()) @db.Timestamptz(3)
  /// VOIDED · RETURNED · DISMISSED; nulo mientras sigue por corregir.
  resolution       String?
  resolvedByUserId String?   @db.Uuid
  resolvedAt       DateTime? @db.Timestamptz(3)
  resolutionNote   String?

  organization Organization @relation(fields: [organizationId], references: [id])
  posSale      PosSale      @relation(fields: [posSaleId, organizationId], references: [id, organizationId], map: "pos_sale_flags_sale_same_org_fk")

  // -- SQL: CHECK (length(btrim(reason)) >= 3)
  // -- SQL: CHECK (resolution IN ('VOIDED','RETURNED','DISMISSED'))
  // -- SQL: CHECK de coherencia: resuelta = con quién y cuándo
  // -- SQL: REVOKE DELETE
  @@index([organizationId, branchId, resolvedAt], map: "pos_sale_flags_org_branch_idx")
  @@map("pos_sale_flags")
}

/// La devolución de una venta de tienda de OTRO día (D-13, bloque 3.5): el
/// dinero sale hoy, el producto vuelve al inventario y la venta original no
/// se toca. Siempre con la firma de la dueña. Una por venta, entera.
model PosSaleReturn {
  id               String            @id @db.Uuid
  organizationId   String            @db.Uuid
  posSaleId        String            @unique(map: "pos_sale_returns_sale_key") @db.Uuid
  branchId         String            @db.Uuid
  amountCents      BigInt
  method           PaymentMethodType
  /// El turno abierto del que sale el dinero (efectivo o terminal en una sede con Caja).
  cashSessionId    String?           @db.Uuid
  returnRef        String?
  reason           String
  approvedByUserId String            @db.Uuid
  createdByUserId  String            @db.Uuid
  businessDate     DateTime          @db.Date
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  posSale      PosSale      @relation(fields: [posSaleId, organizationId], references: [id, organizationId], map: "pos_sale_returns_sale_same_org_fk")
  cashSession  CashSession? @relation(fields: [cashSessionId, organizationId], references: [id, organizationId], map: "pos_sale_returns_session_same_org_fk")

  // -- SQL: CHECK (amountCents > 0)
  // -- SQL: CHECK (length(btrim(reason)) >= 3)
  // -- SQL: CHECK (approvedByUserId <> createdByUserId)
  // -- SQL: REVOKE UPDATE, DELETE (append-only)
  @@index([organizationId, branchId, businessDate], map: "pos_sale_returns_org_branch_date_idx")
  @@index([cashSessionId], map: "pos_sale_returns_session_idx")
  @@map("pos_sale_returns")
}

/// Los plazos del socio de un gimnasio (D-18, bloque 4.4). Sin fila, o con una
/// columna nula, vale el de fábrica del núcleo (`PLAZOS_DEL_SOCIO`: 21, 30, 60,
/// 6 meses, 7 y 90).
model MemberTermSettings {
  organizationId  String   @id @db.Uuid
  dormantDays     Int?
  churnDays       Int?
  lostDays        Int?
  winbackMonths   Int?
  unpaidSaleDays  Int?
  lostDebtDays    Int?
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: CHECK de rangos (los de `DEFINICION_DE_PLAZOS` del núcleo)
  @@map("member_term_settings")
}

/// Los topes del cajón de un gimnasio (D-15, bloque 3.5). Sin fila valen los
/// del núcleo: $500 de fondo y gasto chico sin firma, $5,000 de retiros y
/// depósitos de recepción por turno.
model CashSettings {
  organizationId            String   @id @db.Uuid
  pettyLimitCents           BigInt
  withdrawalShiftLimitCents BigInt
  updatedAt                 DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByUserId           String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: CHECK de rangos (0 a $10,000 y 0 a $100,000)
  @@map("cash_settings")
}

/// Las existencias son POR SUCURSAL: el refresco está físicamente en un
/// refrigerador concreto, y un traspaso entre sedes es un movimiento real.
model InventoryStock {
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  productId      String   @db.Uuid
  quantityOnHand Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "stock_branch_same_org_fk")
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId], map: "stock_product_same_org_fk")

  @@id([branchId, productId])
  // -- SQL: CHECK (quantityOnHand >= 0)
  @@index([organizationId, productId])
  @@map("inventory_stock")
}

/// Libro de movimientos de existencias. Append-only: hacer desaparecer
/// producto sin dejar rastro es la versión en especie del robo hormiga.
model InventoryMovement {
  id             String                @id @db.Uuid
  organizationId String                @db.Uuid
  branchId       String                @db.Uuid
  productId      String                @db.Uuid
  movementType   InventoryMovementType
  /// Firmado: positivo entra, negativo sale.
  quantityDelta  Int
  /// OBLIGATORIO en ajuste, merma y traspaso.
  reason         String?
  /// Enlace a la venta que lo originó, para poder reconstruir el porqué.
  posSaleId      String?               @db.Uuid

  createdByUserId String   @db.Uuid
  at              DateTime @default(now()) @db.Timestamptz(3)
  businessDate    DateTime @db.Date

  product Product @relation(fields: [productId, organizationId], references: [id, organizationId], map: "inv_moves_product_same_org_fk")
  branch  Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "inv_moves_branch_same_org_fk")

  // -- SQL: CHECK (quantityDelta <> 0)
  // -- SQL: CHECK de coherencia entre movementType y el signo
  // -- SQL: CHECK (movementType NOT IN ('ADJUSTMENT','SHRINKAGE','TRANSFER_IN','TRANSFER_OUT') OR reason IS NOT NULL)
  // -- SQL: REVOKE UPDATE, DELETE (append-only)
  @@index([organizationId, branchId, productId, at])
  @@index([organizationId, businessDate])
  @@map("inventory_movements")
}

// ════════════════════════════════════════════════════════════════════════════
// SPRINT 7 · ACCESO
//
// `AccessDecision` y `AttendanceEvent` están SEPARADOS a propósito (ADR-015).
// Una decisión es lo que la política resolvió —incluidas las negativas, que
// son las que más información dan—. Una asistencia es que alguien ENTRÓ de
// verdad. Mezclarlas haría imposible contestar "¿a cuánta gente rechazamos
// este mes y por qué?", que es justo la pregunta que alimenta la pantalla de
// excepción y las alertas de retención.
// ════════════════════════════════════════════════════════════════════════════

enum AccessOutcome {
  GRANTED
  DENIED
}

enum CredentialKind {
  /// EXPAND/CONTRACT (ADR-027). `QR`, `RFID` y `PIN` quedaron sin uso con
  /// ADR-032 y **no se retiran**: `access_decisions` es append-only y hay
  /// historial escrito con esos valores. Se deja de escribirlos, nada más.
  QR
  RFID
  PIN
  FINGERPRINT
  FACE
  MANUAL
}

enum BiometricModality {
  FACE
  FINGERPRINT
}

enum GatewayStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

/// Un gateway por punto de acceso. Se identifica con mTLS.
model AccessGateway {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  code           String
  name           String
  status         GatewayStatus @default(OFFLINE)

  /// Versión de la POLÍTICA que ejecuta, reportada en cada latido.
  /// Si no coincide con la de la nube, la puerta puede estar decidiendo
  /// distinto que el servidor, y eso ocurre SIN ERROR si no se compara.
  policyVersion String?
  /// Versión del padrón firmado que tiene cargado (ADR-015).
  rosterVersion BigInt?

  lastHeartbeatAt DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId], map: "gateways_branch_same_org_fk")
  decisions    AccessDecision[]

  @@unique([id, organizationId], map: "access_gateways_id_org_key")
  // -- SQL: UNIQUE (organizationId, code) WHERE deletedAt IS NULL
  @@index([organizationId, branchId, status])
  @@map("access_gateways")
}

/// Toda decisión de la política, permitida o NEGADA. Append-only.
model AccessDecision {
  id             String  @id @db.Uuid
  organizationId String  @db.Uuid
  branchId       String  @db.Uuid
  gatewayId      String? @db.Uuid
  memberId       String? @db.Uuid

  /// Clave de UN intento (un clic en "Entrada", un paso del torniquete).
  /// El mismo intento enviado dos veces devuelve la misma decisión (UXA-01).
  requestKey String?

  outcome        AccessOutcome
  /// Motivo de la negativa. Nulo si entró.
  denialReason   String?
  credentialKind CredentialKind

  /// Versión de la política que produjo ESTA decisión. Sin ella, un rechazo
  /// discutido meses después no se puede reproducir.
  policyVersion      String
  /// Decidida sin consultar a la nube.
  decidedOffline     Boolean @default(false)
  /// Concesión manual de recepción: lleva actor y motivo (§9).
  overriddenByUserId String? @db.Uuid
  overrideReason     String?
  /// El rechazo que esta concesión RESUELVE (5-10, auditoría 8): un rechazo se
  /// levanta una sola vez, también si dos personas lo intentan a la vez.
  /// Nulo en todo lo que no es una concesión.
  resolvesDecisionId String? @db.Uuid
  /// REENTRADA (D-07, bloque 3.3): ya había entrado hoy en esta sede. La
  /// decisión se registra, pero no nace otra asistencia ni se descuenta visita.
  reentry            Boolean @default(false)

  /**
   * Evidencia del reconocimiento biométrico (ADR-032).
   * Sin esto, un acierto y un falso positivo son indistinguibles en la
   * bitácora: un HMAC prueba, un parecido es una probabilidad, y guardar
   * cuál era es lo único que permite calibrar el umbral después y defender
   * una decisión meses más tarde.
   */
  matchScore     Float?
  /// Distancia con el segundo candidato. Es lo que delata una ambigüedad 1:N.
  matchMargin    Float?
  /// NONE | ACTIVE | PASSIVE | BOTH. Qué comprobación de vida se ejecutó.
  livenessMode   String?
  livenessPassed Boolean?

  at           DateTime @default(now()) @db.Timestamptz(3)
  businessDate DateTime @db.Date

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch           @relation("AccessDecisionBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "decisions_branch_same_org_fk")
  gateway      AccessGateway?   @relation(fields: [gatewayId, organizationId], references: [id, organizationId], map: "decisions_gateway_same_org_fk")
  member       Member?          @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "decisions_member_same_org_fk")
  attendance   AttendanceEvent?
  /// El rechazo que resuelve esta concesión (5-10); uno a uno por la unicidad de abajo.
  resuelve     AccessDecision?  @relation("DecisionResuelve", fields: [resolvesDecisionId, organizationId], references: [id, organizationId], map: "decisions_resolves_same_org_fk", onDelete: Restrict, onUpdate: Cascade)
  resueltaPor  AccessDecision?  @relation("DecisionResuelve")

  @@unique([id, organizationId], map: "access_decisions_id_org_key")
  /// Una concesión por rechazo (5-10). Los NULL no chocan entre sí.
  @@unique([resolvesDecisionId, organizationId], map: "access_decisions_resolves_key")
  // -- SQL: CHECK ((outcome = 'DENIED') = (denialReason IS NOT NULL))
  // -- SQL: CHECK (overriddenByUserId IS NULL OR overrideReason IS NOT NULL)
  // -- SQL: REVOKE UPDATE, DELETE (append-only)
  @@index([organizationId, branchId, businessDate])
  @@index([organizationId, memberId, at(sort: Desc)])
  @@index([organizationId, outcome, businessDate])
  /// El monitor y el pulso piden "lo último de una sede" (OPT3-01).
  @@index([organizationId, branchId, at(sort: Desc)])
  @@map("access_decisions")
}

/// El socio ENTRÓ. Es el hecho de negocio, distinto de la decisión.
model AttendanceEvent {
  id               String @id @db.Uuid
  organizationId   String @db.Uuid
  branchId         String @db.Uuid
  memberId         String @db.Uuid
  /// La decisión que lo autorizó. Única: una entrada por decisión.
  accessDecisionId String @db.Uuid

  at           DateTime @default(now()) @db.Timestamptz(3)
  businessDate DateTime @db.Date

  organization Organization   @relation(fields: [organizationId], references: [id])
  branch       Branch         @relation("AttendanceBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "attendance_branch_same_org_fk")
  member       Member         @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "attendance_member_same_org_fk")
  decision     AccessDecision @relation(fields: [accessDecisionId, organizationId], references: [id, organizationId], map: "attendance_decision_same_org_fk")

  @@unique([accessDecisionId], map: "attendance_decision_key")
  @@unique([accessDecisionId, organizationId], map: "attendance_decision_org_key")
  // -- SQL: REVOKE UPDATE, DELETE (append-only)
  @@index([organizationId, memberId, at(sort: Desc)])
  @@index([organizationId, branchId, businessDate])
  @@map("attendance_events")
}

// ════════════════════════════════════════════════════════════════════════════
// SPRINT 8 · CREDENCIALES Y PADRÓN FIRMADO
// ════════════════════════════════════════════════════════════════════════════

/// Credencial del socio. Un socio puede tener varias (QR y tarjeta, p. ej.).
model MemberCredential {
  id             String         @id @db.Uuid
  organizationId String         @db.Uuid
  memberId       String         @db.Uuid
  kind           CredentialKind

  /// Secreto del QR rotativo, CIFRADO. Es lo que permite al gateway validar
  /// sin red, y por eso viaja en el padrón firmado.
  secretEncrypted String?
  pinHash         String?
  rfidCardId      String?

  /// Anti-replay: el último contador aceptado. Un código ya usado no vuelve
  /// a valer ni dentro de su ventana de treinta segundos.
  lastUsedCounter Int?

  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?

  issuedAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "credentials_member_same_org_fk")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([id, organizationId], map: "member_credentials_id_org_key")
  // -- SQL: UNIQUE (memberId, kind) WHERE revokedAt IS NULL
  //         ^^^ una credencial VIVA por tipo y socio.
  // -- SQL: UNIQUE (organizationId, rfidCardId) WHERE rfidCardId IS NOT NULL AND revokedAt IS NULL
  // -- SQL: CHECK ((revokedAt IS NULL) = (revokedReason IS NULL))
  @@index([organizationId, memberId])
  @@map("member_credentials")
}

// ════════════════════════════════════════════════════════════════════════════
// SPRINT 10 · PORTAL DEL SOCIO
//
// Sesión SEPARADA de la del personal. Reutilizar `Session` obligaría a hacer
// `userId` nulo y perder su clave foránea, y mezclar sesiones de socio y de
// personal en una tabla es una invitación a confundir privilegios: un error
// ahí no falla, autoriza (ADR-023).
// ════════════════════════════════════════════════════════════════════════════

/// Invitación de un solo uso para activar el portal.
///
/// El socio se activa CON RECEPCIÓN DELANTE, que es como ocurre de verdad en
/// el alta. Evita depender de un proveedor de SMS y es más seguro que un
/// código de seis dígitos por mensaje.
model PortalInvite {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  /// sha256 del código. El valor en claro solo existe en el papel o la
  /// pantalla que ve el socio.
  codeHash       String    @unique
  issuedByUserId String?   @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "invites_member_same_org_fk")
  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: UNIQUE (memberId) WHERE usedAt IS NULL
  //         ^^^ una invitación viva por socio: dos códigos válidos a la vez
  //             significan que uno anda suelto sin que nadie lo sepa.
  @@index([organizationId, expiresAt])
  @@map("portal_invites")
}

/// Sesión del socio en el portal.
model MemberSession {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  /// sha256 del identificador opaco. En claro solo vive en la cookie.
  tokenHash      String    @unique
  deviceLabel    String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  revokedReason  String?

  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "member_sessions_member_same_org_fk")
  organization Organization @relation(fields: [organizationId], references: [id])
  pushSubscriptions MemberPushSubscription[]

  // -- SQL: CHECK ((revokedAt IS NULL) = (revokedReason IS NULL))
  @@index([memberId, expiresAt])
  @@index([expiresAt])
  @@map("member_sessions")
}

// ============================================================================
// DOMINIO 8 — ALTA DIGITAL Y CLASES (Sprint 11)
// ============================================================================

enum ConsentDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum MemberIntakeStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum ClassOccurrenceStatus {
  SCHEDULED
  CANCELED
  CLOSED
}

enum ClassBookingStatus {
  BOOKED
  CANCELED
  ATTENDED
  NO_SHOW
}

enum ClassBookingSource {
  PORTAL
  FRONT_DESK
}

/// El TEXTO versionado que se le enseña al socio.
///
/// `MemberConsent` guarda que aceptó; esto guarda QUÉ aceptó. Separarlos evita
/// repetir el mismo texto 1,500 veces y, sobre todo, permite exigir que el
/// texto sea inmutable una vez publicado: si se pudiera editar, la evidencia
/// de los que ya firmaron cambiaría sola.
model ConsentDocument {
  signatureRequests ConsentSignatureRequest[]
  id                String                    @id @db.Uuid
  organizationId    String                    @db.Uuid
  consentType       ConsentType
  version           String
  status            ConsentDocumentStatus     @default(DRAFT)
  title             String
  bodyText          String
  /// sha256 del texto publicado. Es el ancla de la evidencia.
  bodyHash          String?
  publishedAt       DateTime?                 @db.Timestamptz(3)
  publishedByUserId String?                   @db.Uuid
  retiredAt         DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: UNIQUE (organizationId, consentType) WHERE status = 'PUBLISHED'
  //         ^^^ una sola versión vigente por tipo: dos textos publicados a la
  //             vez significa que nadie sabe cuál firmó el socio.
  // -- SQL: trigger que impide cambiar bodyText/version de un PUBLISHED
  @@unique([organizationId, consentType, version])
  @@index([organizationId, status])
  @@map("consent_documents")
}

/// Borrador de alta que manda el SOCIO desde su teléfono.
///
/// No es un socio todavía, y esa distinción es el diseño: un formulario
/// público que escribiera directo en `members` fabricaría un padrón sucio a
/// velocidad industrial. Recepción confirma, con los duplicados delante.
model MemberIntake {
  id             String             @id @db.Uuid
  organizationId String             @db.Uuid
  branchId       String             @db.Uuid
  status         MemberIntakeStatus @default(SUBMITTED)

  firstName String
  lastName  String
  /// Normalizado para la búsqueda difusa de duplicados, igual que en members.
  nameKey   String
  phoneE164 String?
  email     String?
  birthDate DateTime? @db.Date

  emergencyContactName  String?
  emergencyContactPhone String?
  /// "¿Desde cuándo vienes?" — lo contesta el socio (ADR-029).
  memberSince           DateTime? @db.Date
  healthNotes           String?
  /// Papá, mamá o tutor de quien tiene de 15 a 17 años (bloque 3.4, D-10).
  guardianName          String?
  guardianPhoneE164     String?

  /// Qué versión de qué documento aceptó, tal cual se le presentó.
  /// La evidencia definitiva se escribe en `member_consents` al aprobar.
  acceptedConsents Json

  ip          String?
  userAgent   String?
  submittedAt DateTime @default(now()) @db.Timestamptz(3)

  reviewedAt       DateTime? @db.Timestamptz(3)
  reviewedByUserId String?   @db.Uuid
  rejectionReason  String?
  /// Al aprobarse queda ligado al socio creado o actualizado.
  memberId         String?   @db.Uuid

  /// Lo que recepción corrigió o completó y guardó SIN aprobar (bloque 2.4,
  /// 9-21): solo los campos cambiados. El envío original no se toca: es la
  /// evidencia de lo que el socio escribió. Se aplican al aprobar o vincular.
  corrections       Json?
  correctedAt       DateTime? @db.Timestamptz(3)
  correctedByUserId String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation("IntakeBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "intakes_branch_same_org_fk")
  member       Member?      @relation("IntakeConversion", fields: [memberId], references: [id])

  // -- SQL: CHECK ((status = 'APPROVED') = (memberId IS NOT NULL))
  // -- SQL: CHECK ((status = 'REJECTED') <= (rejectionReason IS NOT NULL))
  @@index([nameKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "intakes_name_trgm_idx")
  @@index([organizationId, status, submittedAt(sort: Desc)])
  @@index([memberId])
  @@map("member_intakes")
}

/// Qué clase es. El horario es otra cosa.
model ClassType {
  id                 String  @id @db.Uuid
  organizationId     String  @db.Uuid
  name               String
  description        String?
  defaultDurationMin Int     @default(60)
  defaultCapacity    Int     @default(20)
  /// Precio de la clase suelta para quien no la tiene incluida en su plan.
  dropInPriceCents   BigInt  @default(0)
  /// ¿Puede ir incluida en un plan? Si no, siempre se paga como clase suelta.
  includableInPlans  Boolean @default(true)
  isActive           Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  templates    ClassTemplate[]
  schedules    ClassSchedule[]

  // -- SQL: UNIQUE (organizationId, name) WHERE deletedAt IS NULL
  @@unique([id, organizationId], map: "class_types_id_org_key")
  @@index([organizationId, isActive])
  @@map("class_types")
}

/// La PLANTILLA semanal: "spinning, lunes y miércoles a las 7:00, sala 2".
/// De aquí salen las ocurrencias concretas, que son las que se reservan.
model ClassTemplate {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  branchId       String    @db.Uuid
  classTypeId    String    @db.Uuid
  coachUserId    String?   @db.Uuid
  room           String?
  /// Intervalo SEMIABIERTO `[effectiveFrom, effectiveTo)` (ADR-006).
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branch    Branch              @relation("ClassTemplateBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "class_templates_branch_same_org_fk")
  classType ClassType           @relation(fields: [classTypeId, organizationId], references: [id, organizationId], map: "class_templates_type_same_org_fk")
  slots     ClassTemplateSlot[]
  schedules ClassSchedule[]

  // -- SQL: CHECK (effectiveTo IS NULL OR effectiveTo > effectiveFrom)
  @@index([organizationId, branchId, isActive])
  @@map("class_templates")
}

/// Una franja de la plantilla. La hora se guarda como MINUTOS LOCALES, no como
/// instante: "las 7:00 de la sucursal" sobrevive al cambio de hora; un desfase
/// congelado, no (`resolveWallTime`).
model ClassTemplateSlot {
  id          String @id @db.Uuid
  templateId  String @db.Uuid
  /// 0 = domingo, como `Date.getUTCDay()`.
  weekday     Int    @db.SmallInt
  startMinute Int    @db.SmallInt
  durationMin Int    @db.SmallInt
  capacity    Int    @db.SmallInt

  template ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // -- SQL: CHECK (weekday BETWEEN 0 AND 6)
  // -- SQL: CHECK (startMinute BETWEEN 0 AND 1439)
  // -- SQL: CHECK (durationMin > 0 AND durationMin <= 480)
  // -- SQL: CHECK (capacity > 0)
  @@unique([templateId, weekday, startMinute])
  @@map("class_template_slots")
}

/// La clase CONCRETA del martes 7:00. Es lo que se reserva y lo que se llena.
model ClassSchedule {
  id                 String                @id @db.Uuid
  organizationId     String                @db.Uuid
  branchId           String                @db.Uuid
  classTypeId        String                @db.Uuid
  templateId         String?               @db.Uuid
  coachUserId        String?               @db.Uuid
  room               String?
  /// Clave DERIVADA de plantilla + fecha + franja. El generador corre a diario
  /// sobre un horizonte que se solapa; sin esto, duplicaría cada clase.
  occurrenceKey      String
  startsAt           DateTime              @db.Timestamptz(3)
  endsAt             DateTime              @db.Timestamptz(3)
  businessDate       DateTime              @db.Date
  capacity           Int
  /// Derivado cacheado. Se mueve SOLO con
  /// `UPDATE ... WHERE bookedCount < capacity RETURNING`.
  bookedCount        Int                   @default(0)
  status             ClassOccurrenceStatus @default(SCHEDULED)
  /// `SHIFTED` o `AMBIGUOUS` = el cambio de hora movió esta clase. Se marca
  /// para que alguien la mire, en vez de que se mueva sola sin testigos.
  wallTimeResolution String                @default("EXACT")
  canceledAt         DateTime?             @db.Timestamptz(3)
  cancelReason       String?
  /// La pausa del horario que canceló esta sesión (bloque 2.5): si la pausa
  /// se quita antes de que empiece, la sesión vuelve.
  pauseId            String?               @db.Uuid
  closedAt           DateTime?             @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)

  branch    Branch         @relation("ClassScheduleBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "class_schedules_branch_same_org_fk")
  classType ClassType      @relation(fields: [classTypeId, organizationId], references: [id, organizationId], map: "class_schedules_type_same_org_fk")
  template  ClassTemplate? @relation(fields: [templateId], references: [id])
  bookings  ClassBooking[]

  // -- SQL: CHECK (bookedCount >= 0 AND bookedCount <= capacity)
  // -- SQL: CHECK (endsAt > startsAt)
  // -- SQL: CHECK ((status = 'CANCELED') = (canceledAt IS NOT NULL))
  @@unique([organizationId, occurrenceKey])
  @@unique([id, organizationId], map: "class_schedules_id_org_key")
  @@index([organizationId, branchId, businessDate])
  @@index([organizationId, startsAt])
  @@map("class_schedules")
}

model ClassBooking {
  id              String             @id @db.Uuid
  organizationId  String             @db.Uuid
  branchId        String             @db.Uuid
  classScheduleId String             @db.Uuid
  memberId        String             @db.Uuid
  status          ClassBookingStatus @default(BOOKED)
  source          ClassBookingSource @default(FRONT_DESK)
  /// Solo si es clase suelta de pago.
  chargeId        String?            @unique @db.Uuid
  bookedAt        DateTime           @default(now()) @db.Timestamptz(3)
  bookedByUserId  String?            @db.Uuid
  canceledAt      DateTime?          @db.Timestamptz(3)
  /// Canceló fuera de plazo: liberó la plaza, pero cuenta como falta.
  lateCancel      Boolean            @default(false)
  checkedInAt     DateTime?          @db.Timestamptz(3)
  closedAt        DateTime?          @db.Timestamptz(3)
  /// D-16 (bloque 3.5): hasta cuándo se guarda el lugar de una clase suelta que aún no se paga
  /// (una hora antes de empezar). Pasada esa hora sin pago, se libera y no debe nada.
  holdUntil       DateTime?          @db.Timestamptz(3)

  classSchedule ClassSchedule @relation(fields: [classScheduleId, organizationId], references: [id, organizationId], map: "class_bookings_schedule_same_org_fk")
  member        Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "class_bookings_member_same_org_fk")
  charge        Charge?       @relation(fields: [chargeId], references: [id])

  // -- SQL: UNIQUE (classScheduleId, memberId) WHERE status <> 'CANCELED'
  //         ^^^ la doble reserva se impide en la BASE, no en el servicio:
  //             dos pulsaciones simultáneas ganan a cualquier comprobación
  //             hecha antes de escribir.
  // -- SQL: CHECK ((status = 'CANCELED') = (canceledAt IS NOT NULL))
  @@index([organizationId, memberId, bookedAt(sort: Desc)])
  @@index([classScheduleId, status])
  @@index([organizationId, holdUntil], map: "class_bookings_hold_idx")
  @@map("class_bookings")
}

/// Bloqueo de reservas por faltas (ADR-025). NUNCA es dinero.
///
/// Vive en su propia tabla y no como columna de `members` para no cruzar la
/// frontera del módulo: clases sanciona, socios no sabe de clases.
model ClassBookingBlock {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  /// Semiabierto: bloqueado mientras `now < untilDate`.
  untilDate      DateTime @db.Timestamptz(3)
  noShowCount    Int
  reason         String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  member Member @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "booking_blocks_member_same_org_fk")

  @@index([organizationId, memberId, untilDate(sort: Desc)])
  @@map("class_booking_blocks")
}

/// Las reglas de reserva que fija cada gimnasio (11-08, bloque 2.5). Sin
/// fila valen las de fábrica (`DEFAULT_BOOKING_SETTINGS` del núcleo).
model ClassSettings {
  organizationId      String   @id @db.Uuid
  /// Con cuántos días de antelación se puede reservar.
  maxDaysAhead        Int      @db.SmallInt
  /// Minutos antes de la clase en que cancelar empieza a contar como falta.
  cancelCutoffMinutes Int
  /// Días hacia atrás en que se cuentan las faltas.
  noShowWindowDays    Int      @db.SmallInt
  /// Faltas que bloquean las reservas.
  noShowsBeforeBlock  Int      @db.SmallInt
  /// Días que dura el bloqueo.
  blockDays           Int      @db.SmallInt
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  updatedByUserId     String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: CHECK de rangos, los mismos que `BOOKING_RULE_LIMITS` del núcleo.
  @@map("class_settings")
}

/// Pausa del horario por fechas (11-05, bloque 2.5): «del 22 de diciembre al
/// 2 de enero no hay clases». Mientras esté viva, esos días no se generan
/// sesiones; las que ya existían se cancelaron al crearla.
model ClassPause {
  id              String    @id @db.Uuid
  organizationId  String    @db.Uuid
  /// `null` = todas las sucursales.
  branchId        String?   @db.Uuid
  /// Los dos días incluidos, en el calendario de la sucursal.
  fromDate        DateTime  @db.Date
  toDate          DateTime  @db.Date
  reason          String
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  /// Se quitó antes de terminar: deja de valer desde ese momento.
  endedAt         DateTime? @db.Timestamptz(3)
  endedByUserId   String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation("ClassPauseBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "class_pauses_branch_same_org_fk")

  // -- SQL: CHECK (toDate >= fromDate)
  @@index([organizationId, toDate])
  @@map("class_pauses")
}

// ============================================================================
// DOMINIO 9 — DOMICILIACIÓN (Sprint 12)
// ============================================================================

enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PaymentAttemptOutcome {
  SUCCESS
  SOFT_DECLINE
  /// No se reintenta solo: reintentar sube la tasa de rechazos del comercio,
  /// que las redes penalizan, y no recupera nada.
  HARD_DECLINE
  AUTH_REQUIRED
  ERROR
  /// Sin respuesta. NO es un fallo: bloquea reintentos hasta conciliar.
  UNKNOWN
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ChargebackStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  ACCEPTED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
  DEAD_LETTER
}

/// Tarjeta en archivo. **Nunca el número**: solo el token del proveedor, la
/// marca y los últimos cuatro (§11.7, regla dura 2).
model PaymentMethod {
  id                 String              @id @db.Uuid
  organizationId     String              @db.Uuid
  memberId           String              @db.Uuid
  provider           String
  /// Token del proveedor. Jamás el PAN, ni cifrado.
  providerTokenRef   String
  providerCustomerId String?
  brand              String?
  last4              String?             @db.Char(4)
  expMonth           Int?                @db.SmallInt
  expYear            Int?                @db.SmallInt
  isDefault          Boolean             @default(false)
  /// Mandato de cargos recurrentes. OBLIGATORIO para cobrar off-session: un
  /// cargo sin mandato demostrable es un contracargo que se pierde, porque
  /// la carga de la prueba es del comercio.
  consentId          String?             @db.Uuid
  status             PaymentMethodStatus @default(ACTIVE)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?           @db.Timestamptz(3)
  revokedReason      String?

  organization Organization   @relation(fields: [organizationId], references: [id])
  member       Member         @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "payment_methods_member_same_org_fk")
  consent      MemberConsent? @relation(fields: [consentId], references: [id])
  payments     Payment[]

  // -- SQL: UNIQUE (organizationId, memberId) WHERE isDefault AND status = 'ACTIVE'
  //         ^^^ un solo método predeterminado vivo por socio: dos significa
  //             que nadie sabe con cuál se va a cobrar el día 1.
  // -- SQL: CHECK (last4 IS NULL OR last4 ~ '^[0-9]{4}$')
  // -- SQL: CHECK ((status = 'REVOKED') = (revokedAt IS NOT NULL))
  /// El mismo token no se da de alta dos veces: serían dos tarjetas en la
  /// base y una sola en el procesador. Se declara AQUÍ y no en SQL crudo —
  /// Prisma sabe representar un único normal, y lo que no ve lo borra como
  /// deriva en la siguiente migración.
  @@unique([provider, providerTokenRef])
  @@index([organizationId, memberId, status])
  /// Aviso de tarjeta por vencer antes de que falle el cobro, no después.
  @@index([organizationId, expYear, expMonth])
  @@map("payment_methods")
}

/// Intento contra el procesador.
///
/// La `idempotencyKey` se PERSISTE ANTES de la llamada. Es lo único que
/// permite resolver un timeout sin cobrar dos veces: si el proceso muere
/// entre la llamada y la respuesta, el reintento reconstruye la misma clave
/// y el procesador reconoce la operación en vez de repetirla.
model PaymentAttempt {
  id              String                 @id @db.Uuid
  organizationId  String                 @db.Uuid
  memberId        String                 @db.Uuid
  /// NULLABLE a propósito: el intento se escribe ANTES de llamar, y si el
  /// cobro falla no hay pago que apuntar. Un intento sin pago es el registro
  /// de que se pidió dinero y no entró — que es exactamente lo que hay que
  /// poder demostrar.
  paymentId       String?                @db.Uuid
  chargeId        String?                @db.Uuid
  attemptNumber   Int                    @db.SmallInt
  idempotencyKey  String                 @unique
  outcome         PaymentAttemptOutcome?
  providerCode    String?
  providerMessage String?
  /// Respuesta cruda del proveedor. Es lo que permite reconstruir el pasado
  /// cuando se descubre un defecto meses después.
  rawResponse     Json?
  attemptedAt     DateTime               @default(now()) @db.Timestamptz(3)
  resolvedAt      DateTime?              @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId, organizationId], references: [id, organizationId], map: "attempts_payment_same_org_fk")

  @@unique([chargeId, attemptNumber])
  @@index([organizationId, memberId, attemptedAt(sort: Desc)])
  @@index([organizationId, outcome, attemptedAt(sort: Desc)])
  @@map("payment_attempts")
}

model Refund {
  id                String       @id @db.Uuid
  organizationId    String       @db.Uuid
  paymentId         String       @db.Uuid
  branchId          String?      @db.Uuid
  amountCents       BigInt
  status            RefundStatus @default(PENDING)
  /// OBLIGATORIO. Un reembolso sin motivo es dinero que sale sin explicación.
  reason            String
  createdByUserId   String?      @db.Uuid
  approvedByUserId  String?      @db.Uuid
  externalReference String?
  idempotencyKey    String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  confirmedAt       DateTime?    @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId, organizationId], references: [id, organizationId], map: "refunds_payment_same_org_fk")

  // -- SQL: CHECK (amountCents > 0)
  // -- SQL: trigger SUM(refunds vivos) <= payment.amountCents
  // -- SQL: REVOKE DELETE
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("refunds")
}

/// Contracargo. La ventana real de riesgo en México es de ~135 días desde la
/// FECHA DE CORTE del estado de cuenta del socio, no desde el cargo.
model Chargeback {
  id             String           @id @db.Uuid
  organizationId String           @db.Uuid
  paymentId      String           @db.Uuid
  amountCents    BigInt
  status         ChargebackStatus @default(OPEN)
  providerCaseId String?          @unique
  reasonCode     String?
  openedAt       DateTime         @db.Timestamptz(3)
  dueByAt        DateTime?        @db.Timestamptz(3)
  resolvedAt     DateTime?        @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId, organizationId], references: [id, organizationId], map: "chargebacks_payment_same_org_fk")

  @@index([organizationId, status, openedAt(sort: Desc)])
  @@map("chargebacks")
}

/// Evento crudo del procesador.
///
/// Se persiste ANTES de procesarlo: la ingesta responde 200 y encola, nunca
/// procesa en línea. Un webhook que se procesa en la propia petición se
/// pierde entero si el proceso falla a la mitad, y el proveedor deja de
/// reintentarlo mucho antes de que alguien se dé cuenta.
///
/// `organizationId` es NULLABLE a propósito: el evento puede llegar antes de
/// poder resolver a qué tenant pertenece.
model WebhookEvent {
  id                String             @id @db.Uuid
  organizationId    String?            @db.Uuid
  provider          String
  providerEventId   String
  eventType         String
  rawPayload        Json
  /// VALID | INVALID. Inválida NO se deduplica: se rechaza y se alerta.
  signatureStatus   String
  status            WebhookEventStatus @default(RECEIVED)
  processAttempts   Int                @default(0)
  lastError         String?
  providerCreatedAt DateTime?          @db.Timestamptz(3)
  receivedAt        DateTime           @default(now()) @db.Timestamptz(3)
  processedAt       DateTime?          @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id])

  /// Deduplicación. Es lo que convierte un reenvío del proveedor en un no-op.
  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ============================================================================
// DOMINIO 10 — BIOMETRÍA (ADR-032)
// ============================================================================

/// Constancia de que un socio está enrolado. **NUNCA lleva la plantilla.**
///
/// El vector vive en el equipo de la SUCURSAL y no sale de ahí (ADR-014,
/// confirmado por el dueño el 2026-09-25). Aquí solo está lo que la nube
/// necesita para saber que existe, poder ordenar su borrado y demostrar que
/// hubo consentimiento.
///
/// Cada columna responde a una obligación concreta, no a una comodidad.
model BiometricEnrollment {
  id             String            @id @db.Uuid
  organizationId String            @db.Uuid
  memberId       String            @db.Uuid
  modality       BiometricModality
  /// Dónde vive la plantilla. Sin esto no se puede ordenar que se borre.
  branchId       String            @db.Uuid

  /// Referencia opaca de la plantilla EN EL EQUIPO de la sucursal.
  /// No es el vector: es cómo pedirle al gateway que lo borre.
  templateRef      String
  /// Las plantillas NO son portables entre algoritmos: hay que saber cuál
  /// produjo esta, o al cambiar de motor no se sabe a quién re-enrolar.
  algorithmVendor  String
  algorithmVersion String?

  /// OBLIGATORIO (ADR-014). El indicador "socios con biométrico sin
  /// consentimiento = 0" es incomputable sin esta relación, y un
  /// enrolamiento sin ella es el pasivo heredado que ADR-014 llama el
  /// riesgo principal — recreado a mano.
  consentId String @db.Uuid

  enrolledByUserId String    @db.Uuid
  enrolledAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revokedReason    String?

  /// Cuándo CONFIRMÓ la sucursal que borró la plantilla. Nulo con
  /// `revokedAt` puesto y el plazo vencido = obligación incumplida, y el job
  /// diario tiene que verlo.
  templateDeletedAt DateTime? @db.Timestamptz(3)

  faceTemplate FaceTemplate?
  organization Organization  @relation(fields: [organizationId], references: [id])
  member       Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "enrollments_member_same_org_fk")
  branch       Branch        @relation("EnrollmentBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "enrollments_branch_same_org_fk")
  consent      MemberConsent @relation(fields: [consentId], references: [id])

  // -- SQL: UNIQUE (memberId, branchId, modality) WHERE revokedAt IS NULL
  //         ^^^ un solo enrolamiento vivo por socio, sede y modalidad
  // -- SQL: CHECK ((revokedAt IS NULL) = (revokedReason IS NULL))
  // -- SQL: CHECK (templateDeletedAt IS NULL OR revokedAt IS NOT NULL)
  //         ^^^ no se borra la plantilla de un enrolamiento vivo
  @@index([organizationId, memberId, modality])
  @@index([organizationId, branchId, revokedAt])
  /// Pendientes de borrado: el job los busca por aquí.
  @@index([revokedAt, templateDeletedAt])
  @@map("biometric_enrollments")
}

// ════════════════════════════════════════════════════════════════════════════
// ENTRENAMIENTO · RUTINAS
//
// Adelantado de V1 a pedido del dueño (docs/03 §5.8). Versión mínima: catálogo
// de ejercicios, rutina por días y su asignación al socio, que la ve en su
// teléfono. El registro de series y pesos (SetLog) queda para después.
// ════════════════════════════════════════════════════════════════════════════

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  ABS
}

/// Ejercicio del catálogo. `organizationId` NULO = catálogo GLOBAL de la
/// plataforma (los precargados), de solo lectura para el gimnasio; cada
/// gimnasio agrega los suyos. Toda consulta filtra organizationId IN (el
/// suyo, NULL).
model Exercise {
  id             String      @id @db.Uuid
  organizationId String?     @db.Uuid
  /// Solo los globales: clave estable para sembrar sin duplicar (PECHO-01).
  code           String?     @unique
  name           String
  muscleGroup    MuscleGroup
  equipment      String?
  instructions   String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  organization Organization?         @relation(fields: [organizationId], references: [id])
  items        WorkoutTemplateItem[]

  @@index([organizationId, muscleGroup])
  @@map("exercises")
}

/// La rutina que arma el coach. Los días viven en `dayNames` (1..7, en orden).
model WorkoutTemplate {
  id                  String    @id @db.Uuid
  organizationId      String    @db.Uuid
  name                String
  /// FUERZA · HIPERTROFIA · RESISTENCIA · PERDIDA_PESO · GENERAL
  goal                String?
  /// PRINCIPIANTE · INTERMEDIO · AVANZADO
  level               String?
  notes               String?
  dayNames            String[]
  createdByUserId     String    @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime? @db.Timestamptz(3)
  /// Copia personal de un socio («Personalizar para…», bloque 2.6): no sale en el catálogo.
  personalForMemberId String?   @db.Uuid

  organization Organization          @relation(fields: [organizationId], references: [id])
  items        WorkoutTemplateItem[]
  assignments  WorkoutAssignment[]

  @@unique([id, organizationId], map: "workout_templates_id_org_key")
  @@index([organizationId, archivedAt])
  @@index([organizationId, personalForMemberId])
  @@map("workout_templates")
}

model WorkoutTemplateItem {
  id                String  @id @db.Uuid
  workoutTemplateId String  @db.Uuid
  exerciseId        String  @db.Uuid
  /// 1..7: el día de la rutina, no el de la semana.
  dayIndex          Int
  orderIndex        Int
  sets              Int
  /// "10-12", "15", "al fallo", "30 s".
  reps              String
  restSeconds       Int?
  notes             String?

  template WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id])

  @@unique([workoutTemplateId, dayIndex, orderIndex])
  @@map("workout_template_items")
}

/// La rutina ASIGNADA a un socio. Una sola activa a la vez (índice parcial).
model WorkoutAssignment {
  id                String    @id @db.Uuid
  organizationId    String    @db.Uuid
  memberId          String    @db.Uuid
  workoutTemplateId String    @db.Uuid
  assignedByUserId  String    @db.Uuid
  notes             String?
  assignedAt        DateTime  @default(now()) @db.Timestamptz(3)
  endedAt           DateTime? @db.Timestamptz(3)
  /// Cuándo toca revisarla («Revisar en» 4, 6 u 8 semanas; bloque 2.6). Nula en las de antes.
  reviewOn          DateTime? @db.Date
  /// Quién la terminó (al quitarla o al reemplazarla).
  endedByUserId     String?   @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id])
  member       Member          @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "workout_assignments_member_same_org_fk")
  template     WorkoutTemplate @relation(fields: [workoutTemplateId, organizationId], references: [id, organizationId], map: "workout_assignments_template_same_org_fk")
  logs         WorkoutLog[]

  // -- SQL: UNIQUE (memberId) WHERE endedAt IS NULL
  @@index([organizationId, memberId, endedAt])
  @@map("workout_assignments")
}

/// Un día de la rutina que el socio marcó como hecho («Marcar día hecho», bloque 2.6).
/// «Hoy toca» es el día siguiente al último marcado. Uno por día de rutina y fecha.
model WorkoutLog {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  assignmentId   String   @db.Uuid
  /// 1..7: el día de la rutina, no el de la semana.
  dayIndex       Int
  /// El día de operación (zona del gimnasio) en que lo hizo.
  doneOn         DateTime @db.Date
  /// PORTAL (lo marcó el socio) · COACH.
  source         String   @default("PORTAL")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  assignment WorkoutAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, dayIndex, doneOn])
  @@index([organizationId, memberId, doneOn])
  @@map("workout_logs")
}

/// «HACERME SU COACH» (D-29, fase 3, bloque 3.8). El código que el socio
/// genera en su teléfono y le dicta a su coach: seis dígitos, un solo uso,
/// diez minutos. El valor en claro solo existe en la pantalla del socio.
model CoachLinkCode {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  /// sha256 de gimnasio + código MIENTRAS está vivo; nulo al usarse, anularse
  /// o limpiarse ya caducado. Única: dos códigos vivos nunca coinciden.
  liveKey        String?   @unique
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  usedByUserId   String?   @db.Uuid
  /// Lo anuló uno más nuevo del mismo socio, o caducó sin usarse.
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  // -- SQL: CHECK (liveKey IS NULL OR (usedAt IS NULL AND revokedAt IS NULL))
  @@index([organizationId, memberId])
  @@map("coach_link_codes")
}

/// Cada código que un coach teclea en «Hacerme su coach», para el límite de
/// intentos: cinco fallos en una hora lo dejan en espera.
model CoachLinkAttempt {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  succeeded      Boolean
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, userId, createdAt])
  @@map("coach_link_attempts")
}

/// IMPORTACIÓN DE SOCIOS (docs/09 §3–4). Un archivo del sistema anterior
/// entra aquí en crudo y limpio, se compara contra los socios existentes y
/// entre sus propias filas, una persona del gimnasio revisa lo dudoso y solo
/// entonces se aplica. Nada toca `members` hasta el paso de aplicar.
model MemberImport {
  id              String    @id @db.Uuid
  organizationId  String    @db.Uuid
  /// Sucursal de casa de quien no trae una reconocible en el archivo.
  branchId        String    @db.Uuid
  fileName        String
  /// REVIEW (en revisión) → APPLIED, o CANCELED. Aplicar va por lotes y se puede reanudar.
  status          String    @default("REVIEW")
  /// Fecha de corte del saldo inicial: el día que se congeló el sistema anterior.
  cutoffDate      DateTime  @db.Date
  /// { "Mensualidad": "<planId>" | null }: a qué plan de GymFlow va cada plan del archivo.
  planMap         Json      @default("{}")
  /// { "CENTRO": "<branchId>" }: a qué sucursal va cada sucursal del archivo.
  branchMap       Json      @default("{}")
  totalRows       Int
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  appliedAt       DateTime? @db.Timestamptz(3)
  appliedByUserId String?   @db.Uuid
  canceledAt      DateTime? @db.Timestamptz(3)
  reason          String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "member_imports_organization_fk")
  rows         MemberImportRow[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("member_imports")
}

model MemberImportRow {
  id                  String    @id @db.Uuid
  organizationId      String    @db.Uuid
  importId            String    @db.Uuid
  /// Renglón del archivo (2 = el primero después del encabezado).
  rowNumber           Int
  /// Lo que traía el archivo, sin tocar: para revisar y para reclamaciones.
  raw                 Json
  firstName           String
  lastName            String
  phoneE164           String?
  email               String?
  curp                String?
  birthDate           DateTime? @db.Date
  joinedAt            DateTime? @db.Date
  periodEnd           DateTime? @db.Date
  legacyCode          String?
  branchLabel         String?
  planLabel           String?
  notes               String?
  /// Positivo = debe; negativo = a favor.
  balanceCents        BigInt?
  problems            Json      @default("[]")
  /// NEW · MATCH (es un socio existente, señal fuerte) · REVIEW (dudoso) ·
  /// FILE_DUP (repetido dentro del archivo) · INVALID (no se puede importar).
  kind                String
  matchMemberId       String?   @db.Uuid
  matchRowId          String?   @db.Uuid
  matchScore          Int?
  matchReason         String?
  /// PENDING (falta que una persona decida) · CREATE · MERGE · SKIP.
  decision            String
  decidedByUserId     String?   @db.Uuid
  decidedAt           DateTime? @db.Timestamptz(3)
  appliedMemberId     String?   @db.Uuid
  appliedAt           DateTime? @db.Timestamptz(3)
  /// Lo que pasó al aplicar ("ya tenía membresía vigente: no se creó otra").
  applyNote           String?
  /// Saldo inicial que esta fila DE VERDAD cargó (+ debe, − a favor). Null si
  /// no cargó ninguno: sin saldo, sin ese dato, o porque el socio ya tenía el
  /// de ese registro del sistema anterior (D18-01: reimportar no duplica dinero).
  balanceLoadedCents  BigInt?
  /// Saldo, vigencia o fecha de alta que venían y no se entendieron (D18-02):
  /// `[{ field, value, problem }]`.
  doubtful            Json      @default("[]")
  /// Qué se decidió con esos datos: PENDING (falta) · WITHOUT (entra sin el
  /// dato) · FIXED (una persona escribió el valor). Null = no trae datos dudosos.
  dataStatus          String?
  dataDecidedByUserId String?   @db.Uuid
  dataDecidedAt       DateTime? @db.Timestamptz(3)

  import MemberImport @relation(fields: [importId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "member_import_rows_import_fk")

  @@unique([importId, rowNumber])
  @@index([importId, kind])
  @@index([importId, decision])
  // Los saldos iniciales que ya recibió un socio, en todas sus importaciones.
  @@index([organizationId, appliedMemberId])
  @@map("member_import_rows")
}

/// Códigos del sistema anterior. Se conservan TODOS y son buscables (docs/09
/// §4.4): el socio sigue diciendo "soy el 331" durante meses. También hacen
/// que volver a importar el mismo archivo reconozca a cada quien.
model MemberLegacyCode {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  code           String
  /// De dónde viene el código: la sucursal del archivo o "general".
  source         String
  importId       String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  member Member @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "member_legacy_codes_member_fk")

  @@unique([organizationId, source, code])
  @@index([organizationId, code])
  @@index([memberId])
  @@map("member_legacy_codes")
}

/// Avisos al socio (PS-03): lo que el portal le dice sin canal externo. El
/// job diario los crea con una clave de deduplicación; el socio los marca leídos.
model MemberNotice {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  /// PAYMENT_DUE_SOON · PAYMENT_OVERDUE · CLASS_TOMORROW · INTAKE_APPROVED · PRIVACY_NOTICE_UPDATED · NEW_DEVICE · MEMBERSHIP_SUSPENDED · CLASS_HOLD_RELEASED
  kind           String
  title          String
  body           String
  /// Evita el mismo aviso dos veces: `PAYMENT_DUE_SOON:<chargeId>`.
  dedupeKey      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  readAt         DateTime? @db.Timestamptz(3)

  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "notices_member_same_org_fk")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, dedupeKey], map: "member_notices_org_dedupe_key")
  @@index([organizationId, memberId, createdAt])
  @@map("member_notices")
}

/// Solicitudes ARCO (PS-07): la ley da plazo a cada una; sin fecha de entrada no
/// hay forma de demostrar que se respondió a tiempo.
model PrivacyRequest {
  id                       String    @id @db.Uuid
  organizationId           String    @db.Uuid
  memberId                 String    @db.Uuid
  /// ACCESS · RECTIFICATION · CANCELLATION · OPPOSITION · REVOCATION
  kind                     String
  /// FRONT_DESK · PORTAL · EMAIL · WRITTEN
  channel                  String
  note                     String?
  receivedAt               DateTime  @default(now()) @db.Timestamptz(3)
  /// 20 días hábiles según LFPDPPP art. 32; se guarda ya calculado.
  dueAt                    DateTime  @db.Timestamptz(3)
  resolvedAt               DateTime? @db.Timestamptz(3)
  resolvedByUserId         String?   @db.Uuid
  resolution               String?
  createdByUserId          String?   @db.Uuid
  /// El permiso del que se opone o que revoca (OPPOSITION y REVOCATION).
  consentType              String?
  /// Sin identidad acreditada el plazo no corre (correo o escrito; 21-18).
  identityVerifiedAt       DateTime? @db.Timestamptz(3)
  identityVerifiedByUserId String?   @db.Uuid
  identityNote             String?
  /// GRANTED (procede) · DENIED (no procede). Null en las resueltas antes del ciclo completo.
  outcome                  String?
  /// 15 días hábiles para hacer efectivo lo que procede; se guarda ya calculado.
  effectiveDueAt           DateTime? @db.Timestamptz(3)
  effectedAt               DateTime? @db.Timestamptz(3)
  effectedByUserId         String?   @db.Uuid
  effectNote               String?

  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "privacy_requests_member_same_org_fk")
  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: CHECK kind IN (...), CHECK channel IN (...), CHECK outcome, CHECK consentType, CHECK del ciclo
  // -- SQL: índice parcial (organizationId, effectedAt, effectiveDueAt) WHERE outcome = 'GRANTED'
  @@index([organizationId, resolvedAt, dueAt])
  @@index([organizationId, memberId])
  @@map("privacy_requests")
}

/// CONSERVACIÓN (bloque 3.9; D-32). El día en que los plazos de conservación
/// empezaron a correr en el gimnasio: lo escribe la primera pasada del cierre
/// diario. Para las bajas anteriores, los 30 días del rostro cuentan desde
/// aquí. Una fila por gimnasio; la aplicación solo inserta y lee.
model PrivacyConservationStart {
  organizationId String   @id @db.Uuid
  startedOn      DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: REVOKE UPDATE, DELETE.
  @@map("privacy_conservation_starts")
}

/// P-01 (fase 4, bloque 4.18): el día en que la baja calculada (canceló, o
/// terminó sin renovar) empezó a contar para la conservación en el gimnasio.
/// A quien ese día ya era baja calculada, los 30 días del rostro le cuentan
/// desde aquí (arranque suave). Una fila por gimnasio que no se mueve.
model PrivacyCalculatedBajaStart {
  organizationId String   @id @db.Uuid
  startedOn      DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: REVOKE UPDATE, DELETE.
  @@map("privacy_calculated_baja_starts")
}

/// La lista mensual de exsocios por anonimizar (D-32): la arma el cierre
/// diario y la firma el dueño, una firma por lista. PENDING · SIGNED · REPLACED.
model PrivacyBatch {
  id                 String    @id @db.Uuid
  organizationId     String    @db.Uuid
  /// El mes de la lista: `2026-11`.
  period             String
  status             String    @default("PENDING")
  /// El plazo con el que se armó y el último día de baja que entró.
  monthsAfterArchive Int
  cutoffOn           DateTime  @db.Date
  preparedAt         DateTime  @default(now()) @db.Timestamptz(3)
  signedAt           DateTime? @db.Timestamptz(3)
  signedByUserId     String?   @db.Uuid
  /// Cuándo quedó sin nada por hacer (todo resuelto) o cuándo se reemplazó.
  closedAt           DateTime? @db.Timestamptz(3)

  items        PrivacyBatchItem[]
  organization Organization       @relation(fields: [organizationId], references: [id])
  signedBy     User?              @relation("PrivacyBatchSigner", fields: [signedByUserId], references: [id], onDelete: Restrict)

  // -- SQL: CHECK period, status, meses y firma; único parcial (organizationId) WHERE status = 'PENDING';
  // -- SQL: trigger privacy_batches_firma_trg (lo firmado no cambia); FKs a organizations y users; REVOKE DELETE.
  @@unique([organizationId, period], map: "privacy_batches_org_period_key")
  @@unique([id, organizationId], map: "privacy_batches_id_org_key")
  @@map("privacy_batches")
}

/// Un exsocio en una lista de conservación. Sin nombre: se lee de su ficha
/// mientras exista. LISTED · ANONYMIZED · EXCLUDED · SKIPPED.
model PrivacyBatchItem {
  id               String    @id @db.Uuid
  batchId          String    @db.Uuid
  organizationId   String    @db.Uuid
  memberId         String    @db.Uuid
  memberCode       String
  /// La baja con la que entró a la lista: si regresó y se volvió a ir, ya es otra.
  archivedAt       DateTime  @db.Timestamptz(3)
  /// El día de esa baja en la sede del socio.
  archivedOn       DateTime  @db.Date
  /// P-01 (4.18): ARCHIVED (dado de baja en su ficha) · CANCELED / EXPIRED (la baja calculada de D-18).
  bajaCause        String    @default("ARCHIVED")
  status           String    @default("LISTED")
  note             String?
  resolvedAt       DateTime? @db.Timestamptz(3)
  resolvedByUserId String?   @db.Uuid

  batch  PrivacyBatch @relation(fields: [batchId, organizationId], references: [id, organizationId], map: "privacy_batch_items_batch_same_org_fk")
  member Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "privacy_batch_items_member_same_org_fk", onDelete: Cascade)

  // -- SQL: CHECK status, resuelto y motivo; trigger privacy_batch_items_firma_trg (nadie se anonimiza sin la firma de su lista);
  // -- SQL: FK (memberId, organizationId) → members ON DELETE CASCADE; REVOKE DELETE.
  @@unique([batchId, memberId], map: "privacy_batch_items_batch_member_key")
  @@index([organizationId, memberId], map: "privacy_batch_items_org_member_idx")
  @@map("privacy_batch_items")
}

/// Suscripciones Web Push del personal (DP-10): la firma llega al teléfono del
/// dueño aunque el panel esté cerrado. Sin proveedor externo (VAPID propio).
model PushSubscription {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt     DateTime? @db.Timestamptz(3)
  /// El navegador respondió 404/410: la suscripción murió y se borra en el siguiente envío.
  failedAt       DateTime? @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, userId])
  @@map("push_subscriptions")
}

/// AVISOS A LA DUEÑA (bloque 4.2; D-05). Cada aviso que el sistema le da (caja
/// sin cortar, corte con diferencia por revisar…) y cada resumen del lunes: lo
/// que se ve dentro del panel aunque el teléfono no suene. `dedupeKey` impide
/// mandar dos veces lo mismo. El texto no lleva nombres de socios.
model OwnerAlert {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  /// Uno de `OWNER_ALERT_KINDS` del núcleo.
  kind           String
  dedupeKey      String
  /// Sin FK: solo sirve para decir la sede.
  branchId       String?   @db.Uuid
  title          String
  body           String
  url            String
  /// Renglones del detalle (`lines`) o las cifras del resumen (`figures`, `people`, `from`, `to`).
  detail         Json      @default("{}")
  occurredAt     DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  /// Anotado sin sonar: ya estaba pendiente en la primera corrida del gimnasio.
  silent         Boolean   @default(false)
  pushedAt       DateTime? @db.Timestamptz(3)
  pushDevices    Int       @default(0)
  seenAt         DateTime? @db.Timestamptz(3)
  seenByUserId   String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  // -- SQL: la aplicación no borra (REVOKE DELETE).
  @@unique([organizationId, dedupeKey], map: "owner_alerts_org_dedupe_key")
  @@index([organizationId, createdAt], map: "owner_alerts_org_created_idx")
  @@index([organizationId, kind, createdAt], map: "owner_alerts_org_kind_idx")
  @@map("owner_alerts")
}

/// Desde qué instante avisa cada gimnasio (bloque 4.2): lo escribe la primera
/// corrida de `audit.anomaly-scan`; lo anterior no se manda. Solo se inserta y se lee.
model OwnerAlertStart {
  organizationId String   @id @db.Uuid
  startedAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("owner_alert_starts")
}

/// Qué avisos apagó cada persona en su teléfono (bloque 4.2; D-05). Sin fila,
/// encendido. Apagado, el aviso sigue saliendo dentro del panel. No se borra.
model PushPreference {
  userId         String   @db.Uuid
  kind           String
  organizationId String   @db.Uuid
  enabled        Boolean  @default(true)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@index([organizationId, kind], map: "push_preferences_org_kind_idx")
  @@map("push_preferences")
}

/// Cierre de mes (fase 4): la foto de Entró / Ganado / Gastos por sede que
/// firma el dueño. Lo que llegue después se reconoce en el mes corriente como
/// "ajuste de meses anteriores": el Tablero no reescribe agosto.
model MonthlyClose {
  id               String   @id @db.Uuid
  organizationId   String   @db.Uuid
  /// Primer día del mes cerrado (UTC).
  month            DateTime @db.Date
  /// Totales de la organización y por sede, en centavos como texto (ADR-005).
  totals           Json
  byBranch         Json
  closedByUserId   String   @db.Uuid
  /// Quién firmó el cierre (la segunda firma). Null si cerró el dueño con su
  /// propia contraseña (sin gerente, D-23) o en fotos anteriores al bloque 1.9.
  approvedByUserId String?  @db.Uuid
  closedAt         DateTime @default(now()) @db.Timestamptz(3)
  note             String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, month], map: "monthly_closes_org_month_key")
  @@map("monthly_closes")
}

/// Seguimiento (UX7): cada contacto con un prospecto o con un socio en riesgo,
/// con su resultado y el próximo paso. Solo se agrega (GRANT SELECT, INSERT).
model FollowUp {
  id              String    @id @db.Uuid
  organizationId  String    @db.Uuid
  branchId        String?   @db.Uuid
  prospectId      String?   @db.Uuid
  memberId        String?   @db.Uuid
  /// CALL · WHATSAPP · VISIT · OTHER
  channel         String
  /// ANSWERED · NO_ANSWER · INTERESTED · NOT_INTERESTED · COMING_BACK · TRIAL_VISIT · INTAKE_SENT (los dos últimos, solo de un interesado)
  /// · MESSAGE_SENT (solo lo anota la bandeja de salida al mandar un «te extrañamos»)
  outcome         String
  note            String?
  nextStepOn      DateTime? @db.Date
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  prospect     Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "follow_ups_member_same_org_fk")

  @@index([organizationId, prospectId, createdAt], map: "follow_ups_org_prospect_idx")
  @@index([organizationId, memberId, createdAt], map: "follow_ups_org_member_idx")
  @@map("follow_ups")
}

/// BANDEJA DE SALIDA (auditoría 8, fase 2, bloque 2.9; 25-10, 15-08, 28-14): un
/// mensaje que el gimnasio le debe a un socio. Lo genera el job
/// `outbound.generate` y recepción lo manda con un toque (enlace `wa.me`):
/// nada sale solo (D-34). El texto se arma al leer y se congela en `body` al
/// mandarlo.
model OutboundMessage {
  id               String    @id @db.Uuid
  organizationId   String    @db.Uuid
  /// La sede de casa del socio cuando nació el mensaje (la lista mira la de HOY).
  branchId         String?   @db.Uuid
  memberId         String    @db.Uuid
  /// MEMBERSHIP_SUSPENDED · PAYMENT_OVERDUE · PAYMENT_DUE_SOON · MEMBERSHIP_ENDING · WE_MISS_YOU · PRICE_CHANGE
  kind             String
  /// WHATSAPP_LINK (el enlace que abre recepción). Un proveedor sería otro valor.
  channel          String    @default("WHATSAPP_LINK")
  /// PENDING · SENT · DISMISSED · EXPIRED
  status           String    @default("PENDING")
  /// Evita el mismo mensaje dos veces: `PAYMENT_OVERDUE:<chargeId>`, `WE_MISS_YOU:<memberId>:<estado>:<AAAA-MM>`.
  dedupeKey        String
  /// El hecho: el cargo (pago por vencer o vencido) o la membresía (suspendida, por terminar). Sin FK: solo se lee.
  chargeId         String?   @db.Uuid
  membershipId     String?   @db.Uuid
  /// Solo PRICE_CHANGE: el cambio de precio del que avisa (`membership_price_changes`). Sin FK: solo se lee.
  priceChangeId    String?   @db.Uuid
  /// Solo WE_MISS_YOU: ONBOARDING_AT_RISK · SLIPPING · DORMANT (de ahí sale la plantilla).
  engagementState  String?
  /// Lo que se mandó, tal cual. NULL mientras no se mande.
  body             String?
  /// Por qué caducó: FACT_GONE · SUPERSEDED · STALE · NO_PHONE.
  closeReason      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt       DateTime? @db.Timestamptz(3)
  resolvedByUserId String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "outbound_messages_member_same_org_fk")

  @@unique([organizationId, dedupeKey], map: "outbound_messages_org_dedupe_key")
  @@index([organizationId, status, kind], map: "outbound_messages_org_status_idx")
  @@index([organizationId, memberId, createdAt], map: "outbound_messages_org_member_idx")
  @@map("outbound_messages")
}

/// El teléfono del socio que encendió las notificaciones del portal (fase 3,
/// bloque 3.10; D-34 c). Web Push con llaves propias del servidor: gratis y sin
/// proveedor. El `endpoint` es único en el mundo: un navegador recibe los
/// avisos de UN socio. Atada a la sesión del portal de ese teléfono.
model MemberPushSubscription {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  sessionId      String    @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt     DateTime? @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id])
  member       Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "member_push_subscriptions_member_same_org_fk")
  session      MemberSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "member_push_subscriptions_session_fkey")

  @@index([organizationId, memberId], map: "member_push_subscriptions_org_member_idx")
  @@index([sessionId], map: "member_push_subscriptions_session_idx")
  @@map("member_push_subscriptions")
}

/// Un dato de contacto que el SOCIO cambió desde el portal (fase 4, bloque 4.8;
/// D-36 c: todo directo, incluido el celular). Una fila por dato, con el valor
/// de antes y el de ahora: es lo que el mostrador ve para confirmar con el
/// socio que fue él, y con lo que se cuenta el tope de cambios por periodo.
/// La bitácora no lleva los valores; viven aquí y se vacían al anonimizar.
model MemberContactChange {
  id               String    @id @db.Uuid
  organizationId   String    @db.Uuid
  memberId         String    @db.Uuid
  /// Lo que se guardó junto, en un mismo toque.
  batchId          String    @db.Uuid
  /// PHONE · EMAIL · EMERGENCY_NAME · EMERGENCY_PHONE
  field            String
  oldValue         String?
  newValue         String?
  /// El celular nuevo es también el de otro socio vivo (D-09) y quién dijo el socio que responde por él.
  sharedPhone      Boolean   @default(false)
  responsibleKind  String?
  /// La sesión del portal (el teléfono) desde la que se hizo. Sin FK: las sesiones se purgan.
  sessionId        String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  /// Alguien del mostrador lo confirmó con el socio. Sin FK a `users`: solo se lee.
  reviewedAt       DateTime? @db.Timestamptz(3)
  reviewedByUserId String?   @db.Uuid
  /// Los valores se vaciaron porque la ficha se anonimizó.
  forgottenAt      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "member_contact_changes_member_same_org_fk")

  // -- SQL: CHECK de `field`
  @@index([organizationId, memberId, createdAt], map: "member_contact_changes_org_member_idx")
  @@index([organizationId, reviewedAt], map: "member_contact_changes_org_pending_idx")
  @@map("member_contact_changes")
}

/// De qué quiere el socio que se le notifique al teléfono (bloque 3.10; D-34).
/// Sin fila, todo encendido. Lo de seguridad y de acceso llega siempre.
model MemberNotificationPreference {
  memberId       String   @id @db.Uuid
  organizationId String   @db.Uuid
  payments       Boolean  @default(true)
  classes        Boolean  @default(true)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "member_notification_preferences_member_same_org_fk")

  @@map("member_notification_preferences")
}

/// Plantilla facial de la cámara de recepción (2026-10-09): el embedding
/// cifrado, ligado a su enrolamiento (y por él, a su consentimiento). Se borra
/// al revocar el enrolamiento.
model FaceTemplate {
  enrollmentId       String   @id @db.Uuid
  organizationId     String   @db.Uuid
  branchId           String   @db.Uuid
  memberId           String   @db.Uuid
  embeddingEncrypted String
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  enrollment   BiometricEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, map: "face_templates_enrollment_fk")
  organization Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId, branchId], map: "face_templates_org_branch_idx")
  @@map("face_templates")
}

/// MEDICIÓN DEL RECONOCIMIENTO (auditoría 8, bloque 2.3; 6-10). Un intento de
/// «es» (socio con rostro) o «no es» (alguien que no es socio) frente a la
/// cámara, para fijar el umbral con datos del gimnasio. Solo parecidos: nunca
/// la foto ni la plantilla. `kind` y su relación con `memberId` van con CHECK
/// en la migración.
model FaceMeasurement {
  id               String   @id @db.Uuid
  organizationId   String   @db.Uuid
  branchId         String   @db.Uuid
  kind             String
  memberId         String?  @db.Uuid
  ownScore         Float?
  bestOtherScore   Float?
  compared         Int      @default(0)
  recordedByUserId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt], map: "face_measurements_org_created_idx")
  @@map("face_measurements")
}

/// PASE DE PRUEBA (auditoría 8, fase 3, bloque 3.3; D-08): gratis, UNO por
/// persona, identificada por su celular. Vale el día de operación `validOn` en
/// la sede `branchId`. No es un cargo ni una membresía. El celular no se
/// guarda: `phoneKey` es su huella (sha256 con el gimnasio) y `phoneLast4`
/// sus últimos cuatro dígitos.
model TrialPass {
  id              String   @id @db.Uuid
  organizationId  String   @db.Uuid
  branchId        String   @db.Uuid
  memberId        String   @db.Uuid
  phoneKey        String
  phoneLast4      String
  validOn         DateTime @db.Date
  grantedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation("TrialPassBranch", fields: [branchId, organizationId], references: [id, organizationId], map: "trial_passes_branch_same_org_fk")
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "trial_passes_member_same_org_fk")

  // -- SQL: CHECK ("phoneLast4" ~ '^[0-9]{4}$')
  @@unique([organizationId, phoneKey], map: "trial_passes_org_phone_key")
  @@unique([organizationId, memberId], map: "trial_passes_org_member_key")
  @@index([organizationId, branchId, validOn], map: "trial_passes_org_branch_day_idx")
  @@map("trial_passes")
}

/// CADENA DE PLATAFORMA (auditoría 8, 24-19 y 23-09; bloque 1.11). Lo que
/// GymFlow hace desde su consola, en UNA cadena de hashes propia: el espejo
/// enlazado de cada asiento `platform.*` de las marcas y lo que solo pasa en
/// la consola (entrar, reconfirmar, planes y precios). Append-only por trigger.
model PlatformAuditLog {
  id                    String   @id @db.Uuid
  /// La cuenta de plataforma que actuó; null = el sistema (un job).
  actorUserId           String?  @db.Uuid
  action                String
  /// La marca sobre la que se actuó, si la hay.
  organizationId        String?  @db.Uuid
  resourceType          String
  resourceId            String?
  beforeState           Json?
  afterState            Json?
  reason                String?
  /// Enlace con la cadena de la marca: el asiento espejo y su hash.
  organizationAuditId   String?  @unique @db.Uuid
  organizationAuditHash String?
  ip                    String?
  userAgent             String?
  sessionId             String?  @db.Uuid
  requestId             String?
  prevHash              String?
  hash                  String
  /// Número de eslabón (3.12), igual que en `audit_logs`; NULL = anterior a la secuencia.
  chainSeq              Int?     @unique
  /// Cuándo pasó (igual a `at` salvo en lo importado de antes de la cadena).
  occurredAt            DateTime @db.Timestamptz(3)
  at                    DateTime @default(now()) @db.Timestamptz(3)

  // -- SQL: REVOKE UPDATE, DELETE ON platform_audit_logs FROM gymflow_app
  @@index([at(sort: Desc), id(sort: Desc)], map: "platform_audit_logs_chain_tip_idx")
  @@index([organizationId, at(sort: Desc)])
  @@map("platform_audit_logs")
}

/// CAMBIO DE PRECIO DE UN PLAN (auditoría 8, fase 3, bloque 3.6; D-19): el acto.
/// Subir (o bajar) el precio de un plan mueve en la misma transacción el precio
/// pactado de sus membresías vivas; conservan el suyo las marcadas
/// `priceProtected`, salvo que quien cambia el precio decida incluirlas.
model PlanPriceChange {
  id                 String   @id @db.Uuid
  organizationId     String   @db.Uuid
  planId             String   @db.Uuid
  fromPriceCents     BigInt
  toPriceCents       BigInt
  includedProtected  Boolean  @default(false)
  touchedCount       Int      @default(0)
  protectedKeptCount Int      @default(0)
  reason             String
  createdByUserId    String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  /// Bloque 4.20 (P-14): desde qué día rige. Un aumento, 15 días después de guardarse; NULL = anterior a 4.20 (rigió al guardarse).
  appliesFrom        DateTime? @db.Date

  organization Organization            @relation(fields: [organizationId], references: [id])
  plan         Plan                    @relation(fields: [planId, organizationId], references: [id, organizationId], map: "plan_price_changes_plan_same_org_fk")
  membresias   MembershipPriceChange[]

  // -- SQL: la aplicación solo inserta y lee.
  @@index([organizationId, planId, createdAt], map: "plan_price_changes_org_plan_idx")
  @@map("plan_price_changes")
}

/// A quién le cambió el precio y de cuánto a cuánto (bloque 3.6; D-19). De aquí
/// salen el aviso al teléfono (bandeja de salida) y la línea del recibo.
model MembershipPriceChange {
  id                String   @id @db.Uuid
  organizationId    String   @db.Uuid
  planPriceChangeId String   @db.Uuid
  membershipId      String   @db.Uuid
  memberId          String   @db.Uuid
  fromPriceCents    BigInt
  toPriceCents      BigInt
  wasProtected      Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  /// Bloque 4.20 (P-14): un aumento con fecha «rige desde» espera hasta la primera cuota que empiece y se emita desde ese día. NULL = rigió al guardarse.
  appliesFrom       DateTime? @db.Date
  /// La previsión del primer cobro al precio nuevo (lo que dicen la pantalla y el aviso).
  firstChargeOn     DateTime? @db.Date

  acto       PlanPriceChange @relation(fields: [planPriceChangeId], references: [id], map: "membership_price_changes_acto_fkey")
  aplicacion MembershipPriceApplication?
  member     Member          @relation(fields: [memberId, organizationId], references: [id, organizationId], map: "membership_price_changes_member_same_org_fk", onDelete: Cascade)
  membership Membership      @relation(fields: [membershipId], references: [id], map: "membership_price_changes_membership_fkey", onDelete: Cascade)

  // -- SQL: la aplicación solo inserta y lee.
  @@unique([planPriceChangeId, membershipId], map: "membership_price_changes_acto_membresia_key")
  @@index([organizationId, membershipId, createdAt], map: "membership_price_changes_org_membership_idx")
  @@map("membership_price_changes")
}

/// Cuándo llegó un aumento «por llegar» a una membresía: la cuota que ya lo lleva (bloque 4.20; P-14).
model MembershipPriceApplication {
  id                      String   @id @db.Uuid
  organizationId          String   @db.Uuid
  membershipPriceChangeId String   @db.Uuid
  membershipId            String   @db.Uuid
  /// La cuota emitida con el precio nuevo (sin llave: la cuota nunca se borra).
  chargeId                String?  @db.Uuid
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  cambio     MembershipPriceChange @relation(fields: [membershipPriceChangeId], references: [id], map: "membership_price_applications_cambio_fkey", onDelete: Cascade)
  membership Membership            @relation(fields: [membershipId], references: [id], map: "membership_price_applications_membership_fkey", onDelete: Cascade)

  // -- SQL: la aplicación solo inserta y lee.
  @@unique([membershipPriceChangeId], map: "membership_price_applications_cambio_key")
  @@index([organizationId, membershipId], map: "membership_price_applications_org_membership_idx")
  @@map("membership_price_applications")
}
